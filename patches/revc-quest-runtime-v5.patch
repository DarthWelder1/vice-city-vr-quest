+int32
+CParticle::GetActiveCount(tParticleType type)
+{
+	if(type < 0 || type >= MAX_PARTICLES)
+		return 0;
+	int32 count = 0;
+	for(CParticle *particle = mod_ParticleSystemManager.m_aParticles[type].m_pParticles;
+	    particle; particle = particle->m_pNext)
+		count++;
+	return count;
+}
+
+int32
+CParticle::GetTotalActiveCount(void)
+{
+	int32 count = 0;
+	for(int32 type = 0; type < MAX_PARTICLES; type++)
+		count += GetActiveCount((tParticleType)type);
+	return count;
+}
