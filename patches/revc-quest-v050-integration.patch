+static bool
+WasVrVehicleRecentlySeen(CVehicle *pVehicle, uint32 graceMs)
+{
+	if (pVehicle == nil)
+		return false;
+	CPool<CVehicle, CAutomobile> *pool = CPools::GetVehiclePool();
+	const int32 slot = pool->GetJustIndex_NoFreeAssert(pVehicle);
+	if (slot < 0 || slot >= Min(pool->GetSize(), (int32)NUMVEHICLES) ||
+		pool->GetSlot(slot) != pVehicle ||
+		aVrVehicleHandle[slot] != pool->GetIndex(pVehicle))
+		return false;
+	return CTimer::GetTimeInMilliseconds() - aVrVehicleLastSeen[slot] < graceMs;
+}
