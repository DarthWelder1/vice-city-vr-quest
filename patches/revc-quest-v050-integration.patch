+static float
+VrTrafficMovingRectProximity(const SVrTrafficVehicleSnapshot &vehicleA,
+	const SVrTrafficVehicleSnapshot &vehicleB, float projectionX,
+	float projectionY, float forwardAX, float forwardAY,
+	float forwardBX, float forwardBY)
+{
+	const float vecBToAX = vehicleA.positionX-vehicleB.positionX;
+	const float vecBToAY = vehicleA.positionY-vehicleB.positionY;
+	const float lenB = vehicleB.frontLength;
+	const float widthB = vehicleB.width;
+	const float backLenB = vehicleB.backLength;
+	const float lenA = vehicleA.frontLength;
+	const float widthA = vehicleA.width;
+	const float backLenA = vehicleA.backLength;
+	float proximity = 1.0f;
+	const float fullWidthB = 2.0f*widthB;
+	const float fullLenB = lenB+backLenB;
+
+	for(int32 i = 0; i < 4; i++){
+		float testedOffsetX;
+		float testedOffsetY;
+		switch(i){
+		case 0:
+			testedOffsetX = vecBToAX+widthA*forwardBY+lenA*forwardBX;
+			testedOffsetY = vecBToAY+lenA*forwardBY-widthA*forwardBX;
+			break;
+		case 1:
+			// Preserve the original expression exactly, including its unusual
+			// use of forwardBX for both terms.
+			testedOffsetX = vecBToAX-widthA*forwardBX+lenA*forwardBX;
+			testedOffsetY = vecBToAY+lenA*forwardBY+widthA*forwardBX;
+			break;
+		case 2:
+			testedOffsetX = vecBToAX+widthA*forwardBY-backLenA*forwardBX;
+			testedOffsetY = vecBToAY-backLenA*forwardBY-widthA*forwardBX;
+			break;
+		default:
+			testedOffsetX = vecBToAX-widthA*forwardBY-backLenA*forwardBX;
+			testedOffsetY = vecBToAY-backLenA*forwardBY+widthA*forwardBX;
+			break;
+		}
+
+		float baseWidthProximity = 0.0f;
+		float fullWidthProximity = 1.0f;
+		const float widthDistance = testedOffsetX*forwardAY-
+			testedOffsetY*forwardAX;
+		const float widthProjection = projectionX*forwardAY-
+			projectionY*forwardAX;
+		if(widthDistance > widthB){
+			if(widthProjection < 0.0f){
+				const float p = -(widthDistance-widthB)/widthProjection;
+				if(p < 1.0f){
+					baseWidthProximity = p;
+					fullWidthProximity = Min(1.0f, p-fullWidthB/widthProjection);
+				}else
+					baseWidthProximity = 1.0f;
+			}else{
+				baseWidthProximity = 1.0f;
+				fullWidthProximity = 1.0f;
+			}
+		}else if(widthDistance < -widthB){
+			if(widthProjection > 0.0f){
+				const float p = -(widthDistance+widthB)/widthProjection;
+				if(p < 1.0f){
+					baseWidthProximity = p;
+					fullWidthProximity = Min(1.0f, p+fullWidthB/widthProjection);
+				}else
+					baseWidthProximity = 1.0f;
+			}else{
+				baseWidthProximity = 1.0f;
+				fullWidthProximity = 1.0f;
+			}
+		}else if(widthProjection > 0.0f)
+			fullWidthProximity = (widthB-widthDistance)/widthProjection;
+		else if(widthProjection < 0.0f)
+			fullWidthProximity = -(widthB+widthDistance)/widthProjection;
+
+		float baseLengthProximity = 0.0f;
+		float fullLengthProximity = 1.0f;
+		const float lenDistance = testedOffsetX*forwardAX+
+			testedOffsetY*forwardAY;
+		const float lenProjection = projectionX*forwardAX+
+			projectionY*forwardAY;
+		if(lenDistance > lenB){
+			if(lenProjection < 0.0f){
+				const float p = -(lenDistance-lenB)/lenProjection;
+				if(p < 1.0f){
+					baseLengthProximity = p;
+					fullLengthProximity = Min(1.0f, p-fullLenB/lenProjection);
+				}else
+					baseLengthProximity = 1.0f;
+			}else{
+				baseLengthProximity = 1.0f;
+				fullLengthProximity = 1.0f;
+			}
+		}else if(lenDistance < -backLenB){
+			if(lenProjection > 0.0f){
+				const float p = -(lenDistance+backLenB)/lenProjection;
+				if(p < 1.0f){
+					baseLengthProximity = p;
+					fullLengthProximity = Min(1.0f, p+fullLenB/lenProjection);
+				}else
+					baseLengthProximity = 1.0f;
+			}else{
+				baseLengthProximity = 1.0f;
+				fullLengthProximity = 1.0f;
+			}
+		}else if(lenProjection > 0.0f)
+			fullLengthProximity = (lenB-lenDistance)/lenProjection;
+		else if(lenProjection < 0.0f)
+			fullLengthProximity = -(backLenB+lenDistance)/lenProjection;
+
+		const float baseProximity = Max(baseWidthProximity,
+			baseLengthProximity);
+		if(baseProximity < fullWidthProximity &&
+		   baseProximity < fullLengthProximity)
+			proximity = Min(proximity, baseProximity);
+	}
+	return proximity;
+}
+
+static void
+VrTrafficComputePair(const SVrTrafficVehicleSnapshot &subject,
+	const SVrTrafficVehicleSnapshot &other, SVrTrafficJobResult *result)
+{
+	if(subject.handle == other.handle || !other.usesCollision)
+		return;
+	if(other.boundX < subject.positionX-DISTANCE_TO_SCAN_FOR_DANGER ||
+	   other.boundX > subject.positionX+DISTANCE_TO_SCAN_FOR_DANGER ||
+	   other.boundY < subject.positionY-DISTANCE_TO_SCAN_FOR_DANGER ||
+	   other.boundY > subject.positionY+DISTANCE_TO_SCAN_FOR_DANGER ||
+	   Abs(other.boundZ-subject.positionZ) >= 5.0f)
+		return;
+
+	const float aheadX = other.positionX-subject.positionX;
+	const float aheadY = other.positionY-subject.positionY;
+	if(aheadX*subject.forwardX+aheadY*subject.forwardY < 0.0f)
+		return;
+
+	const float projectionX =
+		other.moveSpeedX*GAME_SPEED_TO_CARAI_SPEED-
+		subject.forwardX*subject.cruiseSpeed;
+	const float projectionY =
+		other.moveSpeedY*GAME_SPEED_TO_CARAI_SPEED-
+		subject.forwardY*subject.cruiseSpeed;
+	const float proximityA = VrTrafficMovingRectProximity(other, subject,
+		projectionX, projectionY, subject.forwardX, subject.forwardY,
+		other.forwardX, other.forwardY);
+	const float proximityB = VrTrafficMovingRectProximity(subject, other,
+		-projectionX, -projectionY, other.forwardX, other.forwardY,
+		subject.forwardX, subject.forwardY);
+	const float minProximity = Min(proximityA, proximityB);
+	if(minProximity >= 0.0f && minProximity < 1.5f){
+		const float scaled = Max(0.0f, (minProximity-0.2f)/1.3f);
+		result->maximumSpeed = Min(result->maximumSpeed,
+			scaled*subject.cruiseSpeed);
+		result->slowedDownBecauseOfCars = true;
+	}
+
+	// The original branch changes status, intrusive world membership and the
+	// autopilot. A worker result must never replace it.
+	// SlowCarDownForOtherCar overwrites minProximity with the remapped value
+	// before running the stuck-car branch. Preserve that observable order:
+	// remapped < 0.5 is equivalent to raw proximity < 0.85.
+	if(minProximity >= 0.0f && minProximity < 0.85f &&
+	   !other.isPlayerVehicle &&
+	   subject.forwardX*other.forwardX+
+		 subject.forwardY*other.forwardY < -0.5f &&
+	   subject.poolSlot < other.poolSlot)
+		// Be deliberately conservative: the main-thread branch also checks two
+		// 15-second timers, but those can cross their threshold after capture.
+		// Any geometrically eligible pair therefore keeps the original scan.
+		result->requiresSynchronousFallback = true;
+}
+
+static void
+VrTrafficComputePedPair(const SVrTrafficVehicleSnapshot &subject,
+	const SVrTrafficPedSnapshot &ped, SVrTrafficPedGeometry *geometry)
+{
+	if(!ped.usesCollision)
+		return;
+	if(ped.positionX < subject.positionX-DISTANCE_TO_SCAN_FOR_DANGER ||
+	   ped.positionX > subject.positionX+DISTANCE_TO_SCAN_FOR_DANGER ||
+	   ped.positionY < subject.positionY-DISTANCE_TO_SCAN_FOR_DANGER ||
+	   ped.positionY > subject.positionY+DISTANCE_TO_SCAN_FOR_DANGER ||
+	   ABS(ped.positionZ-subject.positionZ) >= 4.0f)
+		return;
+
+	const CVector vecToPed(ped.positionX-subject.positionX,
+		ped.positionY-subject.positionY,
+		ped.positionZ-subject.positionZ);
+	const CVector forward(subject.forwardX, subject.forwardY,
+		subject.forwardZ);
+	const CVector right(subject.rightX, subject.rightY, subject.rightZ);
+	const CVector moveSpeed(subject.moveSpeedX, subject.moveSpeedY,
+		subject.moveSpeedZ);
+	const float dotDirection = DotProduct(forward, vecToPed);
+	const float dotVelocity = DotProduct(forward, moveSpeed);
+	if(dotDirection <= subject.frontLength)
+		return;
+
+	const float distanceUntilHit = dotDirection-subject.frontLength;
+	const float movementTowardsPedPerSecond =
+		GAME_SPEED_TO_METERS_PER_SECOND*dotVelocity;
+	if(4.0f*movementTowardsPedPerSecond <= distanceUntilHit)
+		return;
+
+	const float sidewaysDistance = ABS(DotProduct(right, vecToPed));
+	float sideLength = subject.width;
+	if(subject.isBike)
+		sideLength *= 1.6f;
+	if(sideLength+0.5f < sidewaysDistance)
+		return;
+
+	geometry->distanceUntilHit = distanceUntilHit;
+	geometry->dotDirection = dotDirection;
+	geometry->dotVelocity = dotVelocity;
+	geometry->movementTowardsPedPerSecond =
+		movementTowardsPedPerSecond;
+	geometry->sidewaysDistance = sidewaysDistance;
+	geometry->passesGeometry = true;
+}
+
+// Pure path-following geometry for the common ambient cruise case. Link and
+// entity data are copied by the game thread; transitions, traffic queries,
+// lights, bridges and every mutation remain on the game thread.
+static void
+VrTrafficComputeCruiseSteering(const SVrTrafficVehicleSnapshot &subject,
+	SVrTrafficCruiseSteering *cruise)
+{
+	cruise->valid = false;
+	if(!subject.cruiseEligible)
+		return;
+
+	CVector2D forward(subject.forwardX, subject.forwardY);
+	forward.Normalise();
+	const CVector2D currentForward(subject.cruiseCurrentForwardX,
+		subject.cruiseCurrentForwardY);
+	const CVector2D nextForward(subject.cruiseNextForwardX,
+		subject.cruiseNextForwardY);
+	const CVector2D currentLink(subject.cruiseCurrentLinkX,
+		subject.cruiseCurrentLinkY);
+	const CVector2D nextLink(subject.cruiseNextLinkX,
+		subject.cruiseNextLinkY);
+	const CVector2D position(subject.positionX, subject.positionY);
+	const CVector2D distanceToNextNode = position-currentLink;
+	const float scalarDistanceToNextNode =
+		distanceToNextNode.Magnitude();
+	const CVector2D distanceBetweenNodes = nextLink-currentLink;
+	const float distanceBetweenNodesMagnitude =
+		distanceBetweenNodes.Magnitude();
+	const float dp = DotProduct2D(distanceBetweenNodes,
+		distanceToNextNode);
+
+	// Any state that would run PickNextNodeAccordingStrategy (or makes the
+	// original quotient degenerate) deliberately falls back to the untouched
+	// synchronous path.
+	if(scalarDistanceToNextNode < DISTANCE_TO_NEXT_NODE_TO_SELECT_NEW ||
+	   dp > 0.0f && scalarDistanceToNextNode <
+		DISTANCE_TO_FACING_NEXT_NODE_TO_SELECT_NEW ||
+	   scalarDistanceToNextNode <= 0.0f ||
+	   distanceBetweenNodesMagnitude <= 0.0f ||
+	   dp/(scalarDistanceToNextNode*distanceBetweenNodesMagnitude) > 0.7f ||
+	   subject.nextPathNodeInfo == subject.currentPathNodeInfo)
+		return;
+
+	CVector2D projectedPosition = currentLink-
+		currentForward*scalarDistanceToNextNode*0.4f;
+	if(scalarDistanceToNextNode >
+	   DISTANCE_TO_NEXT_NODE_TO_CONSIDER_SLOWING_DOWN)
+		projectedPosition = currentLink;
+	const CVector2D distanceToProjectedPosition =
+		projectedPosition-position;
+	const float angleCurrentLink = CGeneral::GetATanOfXY(
+		distanceToProjectedPosition.x, distanceToProjectedPosition.y);
+	const float angleForward = CGeneral::GetATanOfXY(forward.x,
+		forward.y);
+	float steerAngle = CCarCtrl::LimitRadianAngle(
+		angleCurrentLink-angleForward);
+	const float maxAngle = subject.modelIndex == MI_ENFORCER ?
+		0.7f : DEFAULT_MAX_STEER_ANGLE;
+	steerAngle = Min(maxAngle, Max(-maxAngle, steerAngle));
+	const float moveSpeedMagnitude = Sqrt(
+		subject.moveSpeedX*subject.moveSpeedX+
+		subject.moveSpeedY*subject.moveSpeedY+
+		subject.moveSpeedZ*subject.moveSpeedZ);
+	if(moveSpeedMagnitude > MIN_SPEED_TO_START_LIMITING_STEER)
+		steerAngle = Min(MAX_ANGLE_TO_STEER_AT_HIGH_SPEED,
+			Max(-MAX_ANGLE_TO_STEER_AT_HIGH_SPEED, steerAngle));
+
+	const CVector2D trajectory = currentLink-position;
+	const float speedAngleMultiplier = CCarCtrl::FindSpeedMultiplier(
+		CGeneral::GetATanOfXY(trajectory.x, trajectory.y)-angleForward,
+		MIN_ANGLE_FOR_SPEED_LIMITING, MAX_ANGLE_FOR_SPEED_LIMITING,
+		MIN_LOWERING_SPEED_COEFFICIENT);
+	const float tmpWideMultiplier = CCarCtrl::FindSpeedMultiplier(
+		CGeneral::GetATanOfXY(currentForward.x, currentForward.y)-
+		CGeneral::GetATanOfXY(nextForward.x, nextForward.y),
+		MIN_ANGLE_FOR_SPEED_LIMITING_BETWEEN_NODES,
+		MAX_ANGLE_FOR_SPEED_LIMITING,
+		MIN_LOWERING_SPEED_COEFFICIENT);
+	float speedNodesMultiplier;
+	if(scalarDistanceToNextNode >
+	   DISTANCE_TO_NEXT_NODE_TO_CONSIDER_SLOWING_DOWN ||
+	   subject.rawCruiseSpeed < 12)
+		speedNodesMultiplier = 1.0f;
+	else
+		speedNodesMultiplier = 1.0f-
+			(1.0f-scalarDistanceToNextNode/
+			 DISTANCE_TO_NEXT_NODE_TO_CONSIDER_SLOWING_DOWN)*
+			(1.0f-tmpWideMultiplier);
+
+	cruise->steerAngle = steerAngle;
+	cruise->speedAngleMultiplier = speedAngleMultiplier;
+	cruise->speedNodesMultiplier = speedNodesMultiplier;
+	cruise->currentForwardSpeed =
+		(subject.moveSpeedX*subject.forwardX+
+		 subject.moveSpeedY*subject.forwardY+
+		 subject.moveSpeedZ*subject.forwardZ)*GAME_SPEED_TO_CARAI_SPEED;
+	cruise->valid = true;
+}
+
+class CVrVehicleTrafficJobSystem {
+public:
+	CVrVehicleTrafficJobSystem() : m_stop(false), m_pending(nil),
+		m_workerBusy(false), m_lastDispatchedFrame(0xFFFFFFFFu),
+		m_lastDispatchedEpoch(0), m_pedLookupBatch(nil),
+		m_pedLookupVehicle(nil), m_pedLookupVehicleHandle(-1),
+		m_pedLookupVehicleSlot(-1),
+		m_pedLookupFrame(0xFFFFFFFFu), m_pedLookupEpoch(0)
+	{
+		for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+			m_batches[i].state.store(VR_TRAFFIC_JOB_FREE,
+				std::memory_order_relaxed);
+			m_batches[i].frame = 0;
+			m_batches[i].epoch = 0;
+			m_batches[i].statsReported = true;
+		}
+		m_worker = std::thread(&CVrVehicleTrafficJobSystem::WorkerMain, this);
+	}
+
+	~CVrVehicleTrafficJobSystem()
+	{
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			m_stop = true;
+		}
+		m_wake.notify_one();
+		if(m_worker.joinable())
+			m_worker.join();
+	}
+
+	void BeginFrame(uint32 frame)
+	{
+		CollectCompletedStats();
+		const uint32 epoch = gVrTrafficJobEpoch.load(
+			std::memory_order_relaxed);
+		// Lookup validation is scoped to one CWorld::Process pass, even when a
+		// frontend transition re-enters it without advancing the frame counter.
+		m_pedLookupBatch = nil;
+		m_pedLookupVehicle = nil;
+		m_pedLookupVehicleHandle = -1;
+		m_pedLookupVehicleSlot = -1;
+		m_pedLookupFrame = 0xFFFFFFFFu;
+		m_pedLookupEpoch = 0;
+		// Some frontend/cinema transitions can enter CWorld::Process more than
+		// once without advancing the game frame. Never publish two snapshots for
+		// the same logical frame.
+		if(m_lastDispatchedFrame == frame &&
+		   m_lastDispatchedEpoch == epoch)
+			return;
+		m_lastDispatchedFrame = frame;
+		m_lastDispatchedEpoch = epoch;
+		CCarCtrl::VrTrafficJobBuildMs = 0.0f;
+
+		// Results are useful only during this frame. Do not queue a second batch
+		// behind work that has already missed its same-frame consumption window.
+		if(m_workerBusy.load(std::memory_order_acquire)){
+			CCarCtrl::NumVrTrafficJobSkips++;
+			return;
+		}
+		SVrTrafficJobBatch *batch = AcquireBuildBuffer();
+		if(batch == nil){
+			CCarCtrl::NumVrTrafficJobSkips++;
+			return;
+		}
+
+		const double buildStartedMs = VrTrafficClockMilliseconds();
+		BuildSnapshot(batch, frame);
+		CCarCtrl::VrTrafficJobBuildMs =
+			(float)(VrTrafficClockMilliseconds()-buildStartedMs);
+		CCarCtrl::VrTrafficJobBuildMaxMs = Max(
+			CCarCtrl::VrTrafficJobBuildMaxMs,
+			CCarCtrl::VrTrafficJobBuildMs);
+		if(batch->vehicleCount == 0){
+			batch->state.store(VR_TRAFFIC_JOB_FREE,
+				std::memory_order_release);
+			CCarCtrl::NumVrTrafficJobSkips++;
+			return;
+		}
+
+		std::unique_lock<std::mutex> lock(m_mutex, std::try_to_lock);
+		if(!lock.owns_lock() || m_pending != nil ||
+		   m_workerBusy.load(std::memory_order_relaxed)){
+			batch->state.store(VR_TRAFFIC_JOB_FREE,
+				std::memory_order_release);
+			CCarCtrl::NumVrTrafficJobSkips++;
+			return;
+		}
+		m_pending = batch;
+		batch->state.store(VR_TRAFFIC_JOB_QUEUED,
+			std::memory_order_release);
+		CCarCtrl::NumVrTrafficJobDispatches++;
+		lock.unlock();
+		m_wake.notify_one();
+	}
+
+	bool TryGet(CVehicle *vehicle, float *maximumSpeed,
+		bool *slowedDownBecauseOfCars)
+	{
+		CVehiclePool *pool = CPools::GetVehiclePool();
+		if(pool == nil || vehicle == nil)
+			return false;
+		const int32 handle = pool->GetIndex(vehicle);
+		const int32 slot = pool->GetJustIndex(vehicle);
+		if(slot < 0 || slot >= NUMVEHICLES)
+			return false;
+		const uint32 frame = CTimer::GetFrameCounter();
+		const uint32 epoch = gVrTrafficJobEpoch.load(
+			std::memory_order_relaxed);
+
+		for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+			SVrTrafficJobBatch &batch = m_batches[i];
+			if(batch.state.load(std::memory_order_acquire) !=
+			   VR_TRAFFIC_JOB_READY || batch.frame != frame ||
+			   batch.epoch != epoch)
+				continue;
+			const SVrTrafficJobResult &result = batch.results[slot];
+			if(!result.valid || result.handle != handle ||
+			   result.requiresSynchronousFallback)
+				return false;
+
+			SVrTrafficVehicleSnapshot current;
+			if(!VrCaptureTrafficVehicle(vehicle, slot, &current) ||
+			   current.stateToken != result.stateToken)
+				return false;
+			*maximumSpeed = result.maximumSpeed;
+			*slowedDownBecauseOfCars =
+				result.slowedDownBecauseOfCars;
+			return true;
+		}
+		return false;
+	}
+
+	bool TryGetCruiseSteering(CVehicle *vehicle,
+		SVrTrafficCruiseSteering *cruise)
+	{
+		CVehiclePool *pool = CPools::GetVehiclePool();
+		if(pool == nil || vehicle == nil || cruise == nil)
+			return false;
+		const int32 handle = pool->GetIndex(vehicle);
+		const int32 slot = pool->GetJustIndex(vehicle);
+		if(slot < 0 || slot >= NUMVEHICLES)
+			return false;
+
+		SVrTrafficVehicleSnapshot current;
+		if(!VrCaptureTrafficVehicle(vehicle, slot, &current) ||
+		   !current.cruiseEligible)
+			return false;
+		CCarCtrl::NumVrTrafficCruiseEligible++;
+
+		const uint32 frame = CTimer::GetFrameCounter();
+		const uint32 epoch = gVrTrafficJobEpoch.load(
+			std::memory_order_relaxed);
+		for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+			SVrTrafficJobBatch &batch = m_batches[i];
+			if(batch.state.load(std::memory_order_acquire) !=
+			   VR_TRAFFIC_JOB_READY || batch.frame != frame ||
+			   batch.epoch != epoch)
+				continue;
+			const SVrTrafficJobResult &result = batch.results[slot];
+			if(!result.cruiseEligible || !result.cruise.valid){
+				CCarCtrl::NumVrTrafficCruiseMisses++;
+				return false;
+			}
+			if(result.handle != handle ||
+			   result.cruiseStateToken != current.cruiseStateToken){
+				CCarCtrl::NumVrTrafficCruiseStale++;
+				return false;
+			}
+			*cruise = result.cruise;
+			CCarCtrl::NumVrTrafficCruiseHits++;
+			return true;
+		}
+		CCarCtrl::NumVrTrafficCruiseMisses++;
+		return false;
+	}
+
+	bool TryGetPedGeometry(CVehicle *vehicle, CPed *ped,
+		const CVector &pedPosition, SVrTrafficPedGeometry *geometry)
+	{
+		CVehiclePool *vehiclePool = CPools::GetVehiclePool();
+		CPedPool *pedPool = CPools::GetPedPool();
+		if(vehiclePool == nil || pedPool == nil || vehicle == nil ||
+		   ped == nil || geometry == nil)
+			return false;
+
+		const uint32 frame = CTimer::GetFrameCounter();
+		const uint32 epoch = gVrTrafficJobEpoch.load(
+			std::memory_order_relaxed);
+		const int32 vehicleHandle = vehiclePool->GetIndex(vehicle);
+		if(m_pedLookupVehicle != vehicle ||
+		   m_pedLookupVehicleHandle != vehicleHandle ||
+		   m_pedLookupFrame != frame || m_pedLookupEpoch != epoch){
+			m_pedLookupBatch = nil;
+			m_pedLookupVehicle = vehicle;
+			m_pedLookupVehicleHandle = vehicleHandle;
+			m_pedLookupVehicleSlot = -1;
+			m_pedLookupFrame = frame;
+			m_pedLookupEpoch = epoch;
+
+			const int32 vehicleSlot = vehiclePool->GetJustIndex(vehicle);
+			if(vehicleSlot < 0 || vehicleSlot >= NUMVEHICLES)
+				return false;
+			for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+				SVrTrafficJobBatch &batch = m_batches[i];
+				if(batch.state.load(std::memory_order_acquire) !=
+				   VR_TRAFFIC_JOB_READY || batch.frame != frame ||
+				   batch.epoch != epoch)
+					continue;
+				const SVrTrafficJobResult &result =
+					batch.results[vehicleSlot];
+				if(!result.pedGeometryValid ||
+				   result.handle != vehicleHandle)
+					continue;
+
+				SVrTrafficVehicleSnapshot current;
+				if(!VrCaptureTrafficVehicle(vehicle, vehicleSlot,
+				   &current) ||
+				   current.pedStateToken != result.pedStateToken)
+					return false;
+				m_pedLookupBatch = &batch;
+				m_pedLookupVehicleSlot = vehicleSlot;
+				break;
+			}
+		}
+		if(m_pedLookupBatch == nil || m_pedLookupVehicleSlot < 0)
+			return false;
+
+		const int32 pedSlot = pedPool->GetJustIndex_NoFreeAssert(ped);
+		if(pedSlot < 0 || pedSlot >= NUMPEDS ||
+		   pedPool->GetSlot(pedSlot) != ped)
+			return false;
+		const int32 pedIndex =
+			m_pedLookupBatch->pedIndexBySlot[pedSlot];
+		if(pedIndex < 0 || pedIndex >= m_pedLookupBatch->pedCount)
+			return false;
+		const SVrTrafficPedSnapshot &snapshot =
+			m_pedLookupBatch->peds[pedIndex];
+		if(snapshot.poolSlot != pedSlot ||
+		   pedPool->GetAt(snapshot.handle) != ped ||
+		   snapshot.stateToken != VrTrafficPedStateToken(pedPosition,
+			ped->bUsesCollision))
+			return false;
+
+		*geometry = m_pedLookupBatch->pedGeometry
+			[m_pedLookupVehicleSlot][pedSlot];
+		return true;
+	}
+
+private:
+	SVrTrafficJobBatch *AcquireBuildBuffer()
+	{
+		for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+			int32 expected = VR_TRAFFIC_JOB_FREE;
+			if(m_batches[i].state.compare_exchange_strong(expected,
+			   VR_TRAFFIC_JOB_BUILDING, std::memory_order_acq_rel))
+				return &m_batches[i];
+		}
+		// Current-frame results are never reclaimed. At BeginFrame every READY
+		// buffer is necessarily from an older frame and can be recycled.
+		for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+			int32 expected = VR_TRAFFIC_JOB_READY;
+			if(m_batches[i].state.compare_exchange_strong(expected,
+			   VR_TRAFFIC_JOB_BUILDING, std::memory_order_acq_rel))
+				return &m_batches[i];
+		}
+		return nil;
+	}
+
+	void BuildSnapshot(SVrTrafficJobBatch *batch, uint32 frame)
+	{
+		batch->frame = frame;
+		batch->epoch = gVrTrafficJobEpoch.load(std::memory_order_relaxed);
+		batch->vehicleCount = 0;
+		batch->pedCount = 0;
+		batch->workerMs = 0.0f;
+		batch->statsReported = false;
+		for(int32 i = 0; i < VR_TRAFFIC_GRID_BUCKETS; i++){
+			batch->gridHeads[i] = -1;
+			batch->pedGridHeads[i] = -1;
+		}
+		for(int32 i = 0; i < NUMPEDS; i++)
+			batch->pedIndexBySlot[i] = -1;
+		for(int32 i = 0; i < NUMVEHICLES; i++){
+			batch->results[i].valid = false;
+			batch->results[i].pedGeometryValid = false;
+			batch->results[i].cruiseEligible = false;
+			batch->results[i].cruise.valid = false;
+		}
+
+		CVehiclePool *pool = CPools::GetVehiclePool();
+		if(pool == nil)
+			return;
+		for(int32 slot = 0;
+		    slot < pool->GetSize() && slot < NUMVEHICLES;
+		    slot++){
+			CVehicle *vehicle = pool->GetSlot(slot);
+			SVrTrafficVehicleSnapshot snapshot;
+			if(!VrCaptureTrafficVehicle(vehicle, slot, &snapshot))
+				continue;
+			const int32 index = batch->vehicleCount++;
+			batch->vehicles[index] = snapshot;
+			const int32 bucket = VrTrafficGridHash(snapshot.cellX,
+				snapshot.cellY);
+			batch->vehicles[index].gridNext = batch->gridHeads[bucket];
+			batch->gridHeads[bucket] = index;
+		}
+
+		CPedPool *pedPool = CPools::GetPedPool();
+		if(pedPool == nil)
+			return;
+		for(int32 slot = 0;
+		    slot < pedPool->GetSize() && slot < NUMPEDS;
+		    slot++){
+			CPed *ped = pedPool->GetSlot(slot);
+			SVrTrafficPedSnapshot snapshot;
+			if(!VrCaptureTrafficPed(ped, slot, &snapshot))
+				continue;
+			const int32 index = batch->pedCount++;
+			batch->peds[index] = snapshot;
+			batch->pedIndexBySlot[slot] = (int16)index;
+			const int32 bucket = VrTrafficGridHash(snapshot.cellX,
+				snapshot.cellY);
+			batch->peds[index].gridNext =
+				(int16)batch->pedGridHeads[bucket];
+			batch->pedGridHeads[bucket] = index;
+		}
+	}
+
+	void Compute(SVrTrafficJobBatch *batch)
+	{
+		const double startedMs = VrTrafficClockMilliseconds();
+		for(int32 i = 0; i < batch->vehicleCount; i++){
+			const SVrTrafficVehicleSnapshot &subject = batch->vehicles[i];
+			SVrTrafficJobResult &result = batch->results[subject.poolSlot];
+			result.handle = subject.handle;
+			result.stateToken = subject.stateToken;
+			result.pedStateToken = subject.pedStateToken;
+			result.cruiseStateToken = subject.cruiseStateToken;
+			result.valid = false;
+			result.pedGeometryValid = false;
+			result.cruiseEligible = subject.cruiseEligible;
+			result.cruise.valid = false;
+			VrTrafficComputeCruiseSteering(subject, &result.cruise);
+			memset(batch->pedGeometry[subject.poolSlot], 0,
+				sizeof(batch->pedGeometry[subject.poolSlot]));
+
+			const int32 pedCellX = VrTrafficGridCell(subject.positionX);
+			const int32 pedCellY = VrTrafficGridCell(subject.positionY);
+			for(int32 y = pedCellY-1; y <= pedCellY+1; y++){
+				for(int32 x = pedCellX-1; x <= pedCellX+1; x++){
+					const int32 bucket = VrTrafficGridHash(x, y);
+					for(int32 pedIndex = batch->pedGridHeads[bucket];
+					    pedIndex >= 0;
+					    pedIndex = batch->peds[pedIndex].gridNext){
+						const SVrTrafficPedSnapshot &ped =
+							batch->peds[pedIndex];
+						if(ped.cellX != x || ped.cellY != y)
+							continue;
+						VrTrafficComputePedPair(subject, ped,
+							&batch->pedGeometry[subject.poolSlot]
+								[ped.poolSlot]);
+					}
+				}
+			}
+			result.pedGeometryValid = true;
+
+			if(subject.drivingStyle == DRIVINGSTYLE_AVOID_CARS ||
+			   subject.drivingStyle == DRIVINGSTYLE_PLOUGH_THROUGH)
+				continue;
+
+			result.maximumSpeed = subject.cruiseSpeed;
+			result.valid = true;
+			result.slowedDownBecauseOfCars = false;
+			result.requiresSynchronousFallback = false;
+
+			const int32 queryCellX = VrTrafficGridCell(subject.positionX);
+			const int32 queryCellY = VrTrafficGridCell(subject.positionY);
+			for(int32 y = queryCellY-1; y <= queryCellY+1; y++){
+				for(int32 x = queryCellX-1; x <= queryCellX+1; x++){
+					const int32 bucket = VrTrafficGridHash(x, y);
+					for(int32 otherIndex = batch->gridHeads[bucket];
+					    otherIndex >= 0;
+					    otherIndex = batch->vehicles[otherIndex].gridNext){
+						const SVrTrafficVehicleSnapshot &other =
+							batch->vehicles[otherIndex];
+						if(other.cellX != x || other.cellY != y)
+							continue;
+						VrTrafficComputePair(subject, other, &result);
+					}
+				}
+			}
+		}
+		batch->workerMs = (float)(VrTrafficClockMilliseconds()-startedMs);
+	}
+
+	void CollectCompletedStats()
+	{
+		const uint32 epoch = gVrTrafficJobEpoch.load(
+			std::memory_order_relaxed);
+		for(int32 i = 0; i < VR_TRAFFIC_JOB_BUFFER_COUNT; i++){
+			SVrTrafficJobBatch &batch = m_batches[i];
+			if(batch.state.load(std::memory_order_acquire) !=
+			   VR_TRAFFIC_JOB_READY || batch.statsReported)
+				continue;
+			if(batch.epoch == epoch){
+				CCarCtrl::VrTrafficJobLastMs = batch.workerMs;
+				CCarCtrl::VrTrafficJobMaxMs = Max(
+					CCarCtrl::VrTrafficJobMaxMs, batch.workerMs);
+			}
+			batch.statsReported = true;
+		}
+	}
+
+	void WorkerMain()
+	{
+		for(;;){
+			SVrTrafficJobBatch *batch;
+			{
+				std::unique_lock<std::mutex> lock(m_mutex);
+				m_wake.wait(lock, [this] { return m_stop || m_pending != nil; });
+				if(m_stop)
+					return;
+				batch = m_pending;
+				m_pending = nil;
+				m_workerBusy.store(true, std::memory_order_release);
+				batch->state.store(VR_TRAFFIC_JOB_RUNNING,
+					std::memory_order_release);
+			}
+			Compute(batch);
+			batch->state.store(VR_TRAFFIC_JOB_READY,
+				std::memory_order_release);
+			m_workerBusy.store(false, std::memory_order_release);
+		}
+	}
+
+	SVrTrafficJobBatch m_batches[VR_TRAFFIC_JOB_BUFFER_COUNT];
+	std::thread m_worker;
+	std::mutex m_mutex;
+	std::condition_variable m_wake;
+	bool m_stop;
+	SVrTrafficJobBatch *m_pending;
+	std::atomic<bool> m_workerBusy;
+	uint32 m_lastDispatchedFrame;
+	uint32 m_lastDispatchedEpoch;
+	// Main-thread-only cache. It avoids re-hashing the subject vehicle for
+	// every ped while retaining generation/frame/epoch validation.
+	SVrTrafficJobBatch *m_pedLookupBatch;
+	CVehicle *m_pedLookupVehicle;
+	int32 m_pedLookupVehicleHandle;
+	int32 m_pedLookupVehicleSlot;
+	uint32 m_pedLookupFrame;
+	uint32 m_pedLookupEpoch;
+};
