+// Capturing and validation are game-thread-only. The generation-bearing pool
+// handle prevents a reused slot from accepting a result for its old vehicle.
+static bool
+VrCaptureTrafficVehicle(CVehicle *vehicle, int32 poolSlot,
+	SVrTrafficVehicleSnapshot *snapshot)
+{
+	if(vehicle == nil || vehicle->m_entryInfoList.first == nil)
+		return false;
+	CColModel *colModel = vehicle->GetColModel();
+	if(colModel == nil)
+		return false;
+
+	CVehiclePool *pool = CPools::GetVehiclePool();
+	const CVector position = vehicle->GetPosition();
+	const CVector bound = vehicle->GetBoundCentre();
+	const CVector forward = vehicle->GetForward();
+	const CVector right = vehicle->GetRight();
+	const CVector moveSpeed = vehicle->GetMoveSpeed();
+
+	snapshot->handle = pool->GetIndex(vehicle);
+	snapshot->poolSlot = (int16)poolSlot;
+	snapshot->modelIndex = (int16)vehicle->GetModelIndex();
+	snapshot->gridNext = -1;
+	snapshot->positionX = position.x;
+	snapshot->positionY = position.y;
+	snapshot->positionZ = position.z;
+	snapshot->boundX = bound.x;
+	snapshot->boundY = bound.y;
+	snapshot->boundZ = bound.z;
+	// SlowCarDownForOtherCar normalises a temporary CVector2D, then continues
+	// with the original CVector. Preserve that observable raw XY behaviour.
+	snapshot->forwardX = forward.x;
+	snapshot->forwardY = forward.y;
+	snapshot->forwardZ = forward.z;
+	snapshot->rightX = right.x;
+	snapshot->rightY = right.y;
+	snapshot->rightZ = right.z;
+	snapshot->moveSpeedX = moveSpeed.x;
+	snapshot->moveSpeedY = moveSpeed.y;
+	snapshot->moveSpeedZ = moveSpeed.z;
+	snapshot->width = colModel->boundingBox.max.x;
+	snapshot->frontLength = colModel->boundingBox.max.y;
+	snapshot->backLength = -colModel->boundingBox.min.y;
+	snapshot->cruiseSpeed = vehicle->AutoPilot.GetCruiseSpeed();
+	snapshot->rawCruiseSpeed = vehicle->AutoPilot.m_nCruiseSpeed;
+	snapshot->drivingStyle = vehicle->AutoPilot.m_nDrivingStyle;
+	snapshot->status = vehicle->GetStatus();
+	snapshot->carMission = vehicle->AutoPilot.m_nCarMission;
+	snapshot->tempAction = vehicle->AutoPilot.m_nTempAction;
+	snapshot->createdBy = vehicle->VehicleCreatedBy;
+	snapshot->vehicleType = vehicle->m_vehType;
+	snapshot->usesCollision = vehicle->bUsesCollision;
+	snapshot->isPlayerVehicle = vehicle == FindPlayerVehicle();
+	snapshot->isBike = vehicle->m_vehType == VEHICLE_TYPE_BIKE;
+	snapshot->ignorePathfinding = vehicle->AutoPilot.m_bIgnorePathfinding;
+	snapshot->isLawEnforcer = vehicle->bIsLawEnforcer;
+	snapshot->currentPathNodeInfo = vehicle->AutoPilot.m_nCurrentPathNodeInfo;
+	snapshot->nextPathNodeInfo = vehicle->AutoPilot.m_nNextPathNodeInfo;
+	snapshot->cruiseCurrentLinkX = 0.0f;
+	snapshot->cruiseCurrentLinkY = 0.0f;
+	snapshot->cruiseCurrentForwardX = 0.0f;
+	snapshot->cruiseCurrentForwardY = 0.0f;
+	snapshot->cruiseNextLinkX = 0.0f;
+	snapshot->cruiseNextLinkY = 0.0f;
+	snapshot->cruiseNextForwardX = 0.0f;
+	snapshot->cruiseNextForwardY = 0.0f;
+	snapshot->cruiseEligible = false;
+
+	const bool supportedDrivingStyle =
+		vehicle->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_STOP_FOR_CARS ||
+		vehicle->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_SLOW_DOWN_FOR_CARS ||
+		vehicle->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_STOP_FOR_CARS_IGNORE_LIGHTS;
+	const int32 numLinks = Min(ThePaths.m_numCarPathLinks,
+		(int32)NUM_CARPATHLINKS);
+	if(vehicle->VehicleCreatedBy == RANDOM_VEHICLE &&
+	   vehicle->AutoPilot.m_nCarMission == MISSION_CRUISE &&
+	   vehicle->AutoPilot.m_nTempAction == TEMPACT_NONE &&
+	   vehicle->m_vehType == VEHICLE_TYPE_CAR &&
+	   !snapshot->isPlayerVehicle && !vehicle->bIsLawEnforcer &&
+	   !vehicle->AutoPilot.m_bIgnorePathfinding && supportedDrivingStyle &&
+	   numLinks > 0 &&
+	   vehicle->AutoPilot.m_nCurrentPathNodeInfo < (uint32)numLinks &&
+	   vehicle->AutoPilot.m_nNextPathNodeInfo < (uint32)numLinks){
+		CCarPathLink *currentLink = &ThePaths.m_carPathLinks[
+			vehicle->AutoPilot.m_nCurrentPathNodeInfo];
+		CCarPathLink *nextLink = &ThePaths.m_carPathLinks[
+			vehicle->AutoPilot.m_nNextPathNodeInfo];
+		snapshot->cruiseCurrentForwardX = currentLink->GetDirX() *
+			vehicle->AutoPilot.m_nCurrentDirection;
+		snapshot->cruiseCurrentForwardY = currentLink->GetDirY() *
+			vehicle->AutoPilot.m_nCurrentDirection;
+		snapshot->cruiseNextForwardX = nextLink->GetDirX() *
+			vehicle->AutoPilot.m_nNextDirection;
+		snapshot->cruiseNextForwardY = nextLink->GetDirY() *
+			vehicle->AutoPilot.m_nNextDirection;
+		const float currentLane =
+			(vehicle->AutoPilot.m_nCurrentLane+
+			 currentLink->OneWayLaneOffset())*LANE_WIDTH;
+		const float nextLane =
+			(vehicle->AutoPilot.m_nNextLane+
+			 nextLink->OneWayLaneOffset())*LANE_WIDTH;
+		snapshot->cruiseCurrentLinkX = currentLink->GetX()+
+			currentLane*snapshot->cruiseCurrentForwardY;
+		snapshot->cruiseCurrentLinkY = currentLink->GetY()-
+			currentLane*snapshot->cruiseCurrentForwardX;
+		snapshot->cruiseNextLinkX = nextLink->GetX()+
+			nextLane*snapshot->cruiseNextForwardY;
+		snapshot->cruiseNextLinkY = nextLink->GetY()-
+			nextLane*snapshot->cruiseNextForwardX;
+		snapshot->cruiseEligible = true;
+	}
+	snapshot->cellX = VrTrafficGridCell(bound.x);
+	snapshot->cellY = VrTrafficGridCell(bound.y);
+
+	uint32 token = 2166136261u;
+	token = VrTrafficHashBits(token, (uint32)snapshot->modelIndex);
+	token = VrTrafficHashFloat(token, snapshot->positionX);
+	token = VrTrafficHashFloat(token, snapshot->positionY);
+	token = VrTrafficHashFloat(token, snapshot->positionZ);
+	token = VrTrafficHashFloat(token, snapshot->boundX);
+	token = VrTrafficHashFloat(token, snapshot->boundY);
+	token = VrTrafficHashFloat(token, snapshot->boundZ);
+	token = VrTrafficHashFloat(token, snapshot->forwardX);
+	token = VrTrafficHashFloat(token, snapshot->forwardY);
+	token = VrTrafficHashFloat(token, snapshot->moveSpeedX);
+	token = VrTrafficHashFloat(token, snapshot->moveSpeedY);
+	token = VrTrafficHashFloat(token, snapshot->cruiseSpeed);
+	token = VrTrafficHashBits(token, (uint32)snapshot->drivingStyle);
+	token = VrTrafficHashBits(token, (uint32)snapshot->status);
+	token = VrTrafficHashBits(token, snapshot->usesCollision ? 1u : 0u);
+	token = VrTrafficHashBits(token, snapshot->isPlayerVehicle ? 1u : 0u);
+	snapshot->stateToken = token;
+
+	uint32 pedToken = token;
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->forwardZ);
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->rightX);
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->rightY);
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->rightZ);
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->moveSpeedZ);
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->width);
+	pedToken = VrTrafficHashFloat(pedToken, snapshot->frontLength);
+	pedToken = VrTrafficHashBits(pedToken, snapshot->isBike ? 1u : 0u);
+	snapshot->pedStateToken = pedToken;
+
+	uint32 cruiseToken = pedToken;
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)snapshot->rawCruiseSpeed);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)snapshot->carMission);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)snapshot->tempAction);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)snapshot->createdBy);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)snapshot->vehicleType);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		snapshot->ignorePathfinding ? 1u : 0u);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		snapshot->isLawEnforcer ? 1u : 0u);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		snapshot->cruiseEligible ? 1u : 0u);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		snapshot->currentPathNodeInfo);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		snapshot->nextPathNodeInfo);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)(uint8)vehicle->AutoPilot.m_nCurrentDirection);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)(uint8)vehicle->AutoPilot.m_nNextDirection);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)(uint8)vehicle->AutoPilot.m_nCurrentLane);
+	cruiseToken = VrTrafficHashBits(cruiseToken,
+		(uint32)(uint8)vehicle->AutoPilot.m_nNextLane);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseCurrentLinkX);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseCurrentLinkY);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseCurrentForwardX);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseCurrentForwardY);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseNextLinkX);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseNextLinkY);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseNextForwardX);
+	cruiseToken = VrTrafficHashFloat(cruiseToken,
+		snapshot->cruiseNextForwardY);
+	snapshot->cruiseStateToken = cruiseToken;
+	return true;
+}
+
+static uint32
+VrTrafficPedStateToken(const CVector &position, bool usesCollision)
+{
+	uint32 token = 2166136261u;
+	token = VrTrafficHashFloat(token, position.x);
+	token = VrTrafficHashFloat(token, position.y);
+	token = VrTrafficHashFloat(token, position.z);
+	token = VrTrafficHashBits(token, usesCollision ? 1u : 0u);
+	return token;
+}
+
+static bool
+VrCaptureTrafficPed(CPed *ped, int32 poolSlot,
+	SVrTrafficPedSnapshot *snapshot)
+{
+	if(ped == nil || ped->m_entryInfoList.first == nil)
+		return false;
+	CPedPool *pool = CPools::GetPedPool();
+	if(pool == nil)
+		return false;
+
+	const CVector position = ped->GetPosition();
+	snapshot->handle = pool->GetIndex(ped);
+	snapshot->poolSlot = (int16)poolSlot;
+	snapshot->gridNext = -1;
+	snapshot->positionX = position.x;
+	snapshot->positionY = position.y;
+	snapshot->positionZ = position.z;
+	snapshot->usesCollision = ped->bUsesCollision;
+	snapshot->cellX = VrTrafficGridCell(position.x);
+	snapshot->cellY = VrTrafficGridCell(position.y);
+	snapshot->stateToken = VrTrafficPedStateToken(position,
+		snapshot->usesCollision);
+	return true;
+}
