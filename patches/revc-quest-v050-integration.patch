+void
+CCarCtrl::MarkVrVehicleRendered(CVehicle *pVehicle)
+{
+	if (pVehicle == nil)
+		return;
+	CPool<CVehicle, CAutomobile> *pool = CPools::GetVehiclePool();
+	const int32 slot = pool->GetJustIndex_NoFreeAssert(pVehicle);
+	if (slot < 0 || slot >= Min(pool->GetSize(), (int32)NUMVEHICLES) ||
+		pool->GetSlot(slot) != pVehicle)
+		return;
+
+	// Do not let a reused pool slot inherit a render timestamp from the old
+	// car. UpdateVrTrafficDirector establishes the new generation's history.
+	if (aVrVehicleHandle[slot] == pool->GetIndex(pVehicle))
+		aVrVehicleLastSeen[slot] = CTimer::GetTimeInMilliseconds();
+}
