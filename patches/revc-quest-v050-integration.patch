+static bool
+IsVrPedSpotObservable(const CVector &spot, float radius)
+{
+	CVector target = spot;
+	target.z += 0.9f;
+	CVector toSpot = target - TheCamera.GetPosition();
+	const float distance = toSpot.Magnitude();
+	if (distance < 12.0f)
+		return true;
+	if (distance >= VR_PED_OBSERVABLE_RANGE)
+		return false;
