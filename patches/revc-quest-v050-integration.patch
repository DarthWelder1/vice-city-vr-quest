+	const bool inRenderFrustum = TheCamera.IsSphereVisible(spot, radius);
+	toSpot *= 1.0f / distance;
+	const bool inHeadCone = DotProduct(toSpot, TheCamera.GetForward()) > VR_PED_HEAD_CONE_DOT;
+	if (!inRenderFrustum && !inHeadCone)
+		return false;
+
+	return CWorld::GetIsLineOfSightClear(TheCamera.GetPosition(), target,
+		true, false, false, false, false, false);
