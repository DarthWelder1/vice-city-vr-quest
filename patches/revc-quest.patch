+static const uint8 *
+FindVrDebugGlyph(char character)
+{
+	for(uint32 i = 0; i < ARRAY_SIZE(gVrDebugGlyphs); i++)
+		if(gVrDebugGlyphs[i].character == character)
+			return gVrDebugGlyphs[i].rows;
