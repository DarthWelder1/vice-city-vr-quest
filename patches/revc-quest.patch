+	case 9: VehicleCheat(MI_BLOODRA); break;
+	case 10: VehicleCheat(MI_BLOODRB); break;
+	case 11: VehicleCheat(MI_ROMERO); break;
+	case 12: VehicleCheat(MI_LOVEFIST); break;
+	case 13: VehicleCheat(MI_TRASH); break;
+	case 14: VehicleCheat(MI_SABRETUR); break;
+	case 15: VehicleCheat(MI_CADDY); break;
+	case 16: VehicleCheat(MI_HOTRINA); break;
+	case 17: VehicleCheat(MI_HOTRINB); break;
+	case 18: BlowUpCarsCheat(); break;
+	case 19: ChangePlayerCheat(); break;
+	case 20: ChangePlayerModel("igbuddy"); break;
+	case 21: ChangePlayerModel("igcandy"); break;
+	case 22: ChangePlayerModel("igken"); break;
+	case 23: ChangePlayerModel("ighlary"); break;
+	case 24: ChangePlayerModel("igjezz"); break;
+	case 25: ChangePlayerModel("igphil"); break;
+	case 26: ChangePlayerModel("igsonny"); break;
+	case 27: ChangePlayerModel("igmerc"); break;
+	case 28: ChangePlayerModel("igdick"); break;
+	case 29: ChangePlayerModel("igdiaz"); break;
+	case 30: gfTommyFatness = 0.26f; break;
+	case 31: gfTommyFatness = -0.3f; break;
+	case 32: MayhemCheat(); break;
+	case 33: EverybodyAttacksPlayerCheat(); break;
+	case 34: WeaponsForAllCheat(); break;
+	case 35: DoChicksWithGunsCheat(); break;
+	case 36: FannyMagnetCheat(); break;
+	case 37: PickUpChicksCheat(); break;
+	case 38: ExtraSunnyWeatherCheat(); break;
+	case 39: SunnyWeatherCheat(); break;
+	case 40: CloudyWeatherCheat(); break;
+	case 41: RainyWeatherCheat(); break;
+	case 42: FoggyWeatherCheat(); break;
+	case 43: FastWeatherCheat(); break;
+	case 44: FastTimeCheat(); break;
+	case 45: SlowTimeCheat(); break;
+	case 46: OnlyRenderWheelsCheat(); break;
+	case 47: ChittyChittyBangBangCheat(); break;
+	case 48: BackToTheFuture(); break;
+	case 49: FlyingFishCheat(); break;
+	case 50: StrongGripCheat(); break;
+	case 51: SpecialCarCheats(); break;
+	case 52: TrafficLightsCheat(); break;
+	case 53: MadCarsCheat(); break;
+	case 54: BlackCarsCheat(); break;
+	case 55: PinkCarsCheat(); break;
+	case 56: DoShowChaseStatCheat(); break;
+	case 57: CSmokeTrails::CigOn = !CSmokeTrails::CigOn; break;
+	case 58: SuicideCheat(); break;
+	default: return false;
+	}
+	return true;
+}
