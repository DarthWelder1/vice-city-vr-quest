+		return false;
+
+	m_pSoundFile->Seek(0);
+	if ( nPos != 0 )
+		m_pSoundFile->Seek(nPos);
+
+	for ( int32 i = 0; i < bufferCount; i++ )
+	{
+		void *target = (uint8*)m_pPreparedBuffer + (size_t)bufferSize * i;
+		uint32 size = m_pSoundFile->Decode(target);
+		if ( size == 0 )
