+static RpMaterial*
+MaterialSetOpaqueWhite(RpMaterial *material, void*)
+{
+	RwRGBA *colour = (RwRGBA*)RpMaterialGetColor(material);
+	colour->red = 255;
+	colour->green = 255;
+	colour->blue = 255;
+	colour->alpha = 255;
+	return material;
+}
+
+static RpAtomic*
+RestoreQuestCutsceneAtomic(RpAtomic *atomic, void*)
+{
+	RpGeometry *geometry = RpAtomicGetGeometry(atomic);
+	if(geometry == nil)
+		return atomic;
+
+	// Cutscene character DFFs are lit and have no prelight.  Their materials
+	// are already white, and the classic Android transparency workaround only
+	// needs them opaque.  Forcing MODULATE on just the first atomic made the
+	// Vulkan skin path depend on a zero cutscene-light value and left every
+	// actor black.  Restore every atomic to the DFF's non-modulated state.
+	RpGeometrySetFlags(geometry,
+		RpGeometryGetFlags(geometry) & ~rpGEOMETRYMODULATEMATERIALCOLOR);
+	RpGeometryForAllMaterials(geometry, MaterialSetOpaqueWhite, nil);
+	return atomic;
+}
+
+static void
+EnsureQuestCutsceneAmbientFloor(void)
+{
+	if(pAmbient == nil)
+		return;
+
+	// Native theater cutscenes can briefly inherit an almost black object
+	// ambient (the opening interior is the reproducible case).  The Vulkan
+	// skin path has no prelight term for these lit DFFs, so that value turns
+	// the complete textured actor into a silhouette.  Do not go back to the
+	// old full-white ambient workaround: it removed all of Vice City's
+	// directional modelling.  Raise only genuinely under-lit frames and keep
+	// their colour ratio and directional light intact.
+	const float minChannel = 0.28f;
+	RwRGBAReal colour = pAmbient->color;
+	const float strongest = Max(colour.red, Max(colour.green, colour.blue));
+	if(strongest >= minChannel)
+		return;
+
+	if(strongest > 0.001f){
+		const float scale = minChannel / strongest;
+		colour.red = Min(1.0f, colour.red * scale);
+		colour.green = Min(1.0f, colour.green * scale);
+		colour.blue = Min(1.0f, colour.blue * scale);
+	}else{
+		colour.red = minChannel;
+		colour.green = minChannel;
+		colour.blue = minChannel;
+	}
+	colour.alpha = 1.0f;
+	RpLightSetColor(pAmbient, &colour);
+}
+#endif
