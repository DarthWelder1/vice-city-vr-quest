 }
 
+// Copies the current DirectShow movie frame into an RGBA theatre texture.
+// GetCurrentImage returns a packed DIB, normally bottom-up BGRX.
+bool CaptureMovieFrameRGBA(uint8 *destination, int destinationWidth, int destinationHeight)
+{
+	if(!pVMRWindowless9 || !destination || destinationWidth <= 0 || destinationHeight <= 0)
+		return false;
+	BYTE *dib = nil;
+	if(FAILED(pVMRWindowless9->GetCurrentImage(&dib)) || !dib)
+		return false;
+	BITMAPINFOHEADER *header = (BITMAPINFOHEADER*)dib;
+	const int sourceWidth = header->biWidth;
+	const int sourceHeight = Abs(header->biHeight);
+	const int bytesPerPixel = header->biBitCount / 8;
+	if(sourceWidth <= 0 || sourceHeight <= 0 ||
+	   (bytesPerPixel != 3 && bytesPerPixel != 4) || header->biCompression != BI_RGB){
+		CoTaskMemFree(dib);
+		return false;
+	}
+	const int sourceStride = ((sourceWidth*header->biBitCount+31)/32)*4;
+	const uint8 *source = dib + header->biSize;
+	memset(destination, 0, destinationWidth*destinationHeight*4);
+	const float sourceAspect = (float)sourceWidth/(float)sourceHeight;
+	const float destinationAspect = (float)destinationWidth/(float)destinationHeight;
+	int drawWidth = destinationWidth, drawHeight = destinationHeight;
+	if(sourceAspect > destinationAspect)
+		drawHeight = Max(1, (int)(destinationWidth/sourceAspect+0.5f));
+	else
+		drawWidth = Max(1, (int)(destinationHeight*sourceAspect+0.5f));
+	const int offsetX = (destinationWidth-drawWidth)/2;
+	const int offsetY = (destinationHeight-drawHeight)/2;
+	for(int y = 0; y < drawHeight; y++){
+		int sourceY = y*sourceHeight/drawHeight;
+		if(header->biHeight > 0) sourceY = sourceHeight-1-sourceY;
+		const uint8 *sourceRow = source + sourceY*sourceStride;
+		uint8 *destinationRow = destination + ((offsetY+y)*destinationWidth+offsetX)*4;
+		for(int x = 0; x < drawWidth; x++){
+			const uint8 *pixel = sourceRow + (x*sourceWidth/drawWidth)*bytesPerPixel;
+			destinationRow[x*4+0] = pixel[2];
+			destinationRow[x*4+1] = pixel[1];
+			destinationRow[x*4+2] = pixel[0];
+			destinationRow[x*4+3] = 255;
+		}
+	}
+	CoTaskMemFree(dib);
+	return true;
+}
