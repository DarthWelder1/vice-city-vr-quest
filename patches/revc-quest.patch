+// the Quest's portrait per-eye image, however, so CalcScreenCoors uses that
+// portrait view window.  World geometry consequently follows the 16:9 theater
+// projection while Im2D coronas (most visibly moving vehicle headlights)
+// follow the narrower portrait projection and appear detached from the model.
+//
+// Remap only theater-mode world sprites from the active RenderWare projection
+// to the projection used by makeTheaterMatrices in android_main.cpp.  Immersive
+// gameplay keeps the regular per-eye path unchanged.
+static void
+RemapCoronaToQuestTheater(RwV3d *screen, float *width, float *height)
+{
+	if(!androidgame::VrShouldUseTheaterMode())
+		return;
+
+	const RwV2d *viewWindow = RwCameraGetViewWindow(Scene.camera);
+	if(viewWindow == nil || viewWindow->x <= 0.01f ||
+	   viewWindow->y <= 0.01f)
+		return;
+
+	const float theaterViewY = Tan(DEGTORAD(60.0f * 0.5f));
+	const float theaterViewX = theaterViewY * (16.0f / 9.0f);
+	const float scaleX = viewWindow->x / theaterViewX;
+	const float scaleY = viewWindow->y / theaterViewY;
+	const float centerX = SCREEN_WIDTH * 0.5f;
+	const float centerY = SCREEN_HEIGHT * 0.5f;
+
+	screen->x = centerX + (screen->x - centerX) * scaleX;
+	screen->y = centerY + (screen->y - centerY) * scaleY;
+	*width *= scaleX;
+	*height *= scaleY;
+}
