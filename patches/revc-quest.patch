+struct WorldCloudBatch
+{
+	RwIm3DVertex vertices[WORLD_CLOUD_QUAD_CAPACITY * 4];
+	RwImVertexIndex indices[WORLD_CLOUD_QUAD_CAPACITY * 6];
+	int32 vertexCount;
+	int32 indexCount;
