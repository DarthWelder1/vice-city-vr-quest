+bool
+CRenderer::IsEntityOutsideCurrentView(CEntity *ent, bool complex)
+{
+#if defined(GTA_VR_OCULUS) || defined(RW_VULKAN)
+	if(ms_bVrOmnidirectionalScan)
+		return false;
+#endif
+	return (complex ? !ent->GetIsOnScreenComplex() : !ent->GetIsOnScreen()) ||
+		ent->IsEntityOccluded();
+}
+
+#if defined(GTA_VR_OCULUS) || defined(RW_VULKAN)
+bool
+CRenderer::ShouldRenderInCurrentView(CEntity *ent)
+{
+	if(!ms_bVrPerViewCulling)
+		return true;
+	if(ent == nil || ent->m_rwObject == nil)
+		return false;
+#ifdef RW_VULKAN
+	// The game camera's frustum test is useless here: the headset view is
+	// wider and rotates freely away from it. Cull with a generous cone around
+	// the actual view direction instead -- big buildings and the near field
+	// always draw, everything else needs to be within 105 degrees of where
+	// the player is looking.
+	{
+		rw::float32 viewYaw;
+		if(!rw::vulkan::getFirstPersonViewYaw(&viewYaw))
+			return true;	// camera-anchored frames draw everything
+		if(ent->bIsBIGBuilding)
+			return true;
+		// The entity position is the model origin, which for road pieces can
+		// sit tens of metres from the mesh under the player's feet. Slack the
+		// test by the bounding radius or the ground gets culled in patches.
+		const float radius = ent->GetBoundRadius();
+		const CVector to = ent->GetPosition() - ms_vecCameraPosition;
+		const float d2 = to.x*to.x + to.y*to.y;
+		if(d2 < SQR(20.0f + radius))
+			return true;
+		float ang = Atan2(to.y, to.x) - viewYaw;
+		while(ang > PI) ang -= TWOPI;
+		while(ang < -PI) ang += TWOPI;
+		const float dist = Sqrt(d2);
+		const float slack = Asin(Min(1.0f, radius/dist));
+		return Abs(ang) < DEGTORAD(105.0f) + slack;
+	}
+#endif
+	// Large buildings need their full box tested. Ordinary entities use the
+	// same cheaper sphere test as the original renderer.
+	if(!(ent->bIsBIGBuilding ? ent->GetIsOnScreenComplex() : ent->GetIsOnScreen()))
+		return false;
+
+#ifdef GTA_VR_OPENXR
+	// OpenXR renders a shared symmetric source frustum and remaps it into the two
+	// physical eye frustums afterwards. The active Vice City occluder list was
+	// constructed earlier from the desktop/game camera, so applying its 2D screen
+	// rectangles here can reject entities that are visible in the VR source image.
+	// Keep the real per-eye frustum test above, but do not reuse stale screen-space
+	// occlusion data. This still culls the 360-degree safety list before draw calls.
+	return true;
+#else
+	// ScanWorld intentionally keeps a 360-degree safety list for instant head
+	// turns. Once the actual eye camera is active, recover the original engine's
+	// occlusion culling so distant detail hidden behind buildings emits no draw
+	// calls. The occlusion test uses the current eye camera.
+	return !ent->IsEntityOccluded();
+#endif
+}
+#endif
