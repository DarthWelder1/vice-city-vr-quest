 bool
 DoRWStuffStartOfFrame_Horizon(int16 TopRed, int16 TopGreen, int16 TopBlue, int16 BottomRed, int16 BottomGreen, int16 BottomBlue, int16 Alpha)
 {
+#ifdef RW_VULKAN
+	// Rendering runs on the eye's real field of view, set before CameraSize
+	// derives the view window from it -- the desktop's BeginEye equivalent.
+	{
+		extern void VrApplyEyeFov(void);
+		VrApplyEyeFov();
+	}
+#endif
 	CDraw::CalculateAspectRatio();
 	CameraSize(Scene.camera, nil, SCREEN_VIEWWINDOW, SCREEN_ASPECT_RATIO);
 	CVisibilityPlugins::SetRenderWareCamera(Scene.camera);
 	RwCameraClear(Scene.camera, &gColourTop, CLEARMODE);
 
+#ifdef RW_VULKAN
+	// The Im2D plane must subtend the same angles this view window does.
+	{
+		extern void VrCaptureViewWindow(void);
+		VrCaptureViewWindow();
+	}
+	// Anchor BEFORE the camera update below: RwCameraBeginUpdate is where
+	// the backend composes the world transform from the anchor, so a stale
+	// anchor there renders the whole frame one game-step behind the player.
+	// At speed that step is half a metre -- the view trailed the car by
+	// exactly speed-times-frame-time, saturating at top speed.
+	extern void VrUpdateFirstPersonAnchor(bool postPhysics);
+	VrUpdateFirstPersonAnchor(true);
+#endif
+
 	if(!RsCameraBeginUpdate(Scene.camera))
 		return false;
 
 	TheCamera.m_viewMatrix.Update();
+#ifdef RW_VULKAN
+	// The sky gradient is drawn as full-screen 2D quads, which on the headset
+	// end up on the floating panel: a glassy rectangle hanging mid-view. Feed
+	// the sky colour to the backend as the clear colour instead, so it fills
+	// the entire view, and skip the quads.
+	rw::vulkan::setClearColour((uint8)TopRed, (uint8)TopGreen, (uint8)TopBlue);
+	(void)BottomRed; (void)BottomGreen; (void)BottomBlue; (void)Alpha;
+#else
 	CClouds::RenderBackground(TopRed, TopGreen, TopBlue, BottomRed, BottomGreen, BottomBlue, Alpha);
+#endif
 
 	return true;
 }
