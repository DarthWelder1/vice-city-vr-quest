+
+static uint8
+CloudColourLerp(uint8 bottom, uint8 top, float topFactor)
+{
+	topFactor = clamp(topFactor, 0.0f, 1.0f);
+	return (uint8)(bottom + (top - bottom)*topFactor);
+}
+
+static void
+AddWorldCloudQuad(WorldCloudBatch &batch, const CVector &originalCenter,
+	const CVector &cameraPosition, float halfWidth, float halfHeight,
+	float rotation, const CRGBA &top, const CRGBA &bottom)
+{
+	if(batch.vertexCount + 4 > (int32)ARRAY_SIZE(batch.vertices))
+		return;
+
+	// The original clouds are screen sprites and therefore ignore the world
+	// far plane.  Preserve their apparent angular size while bringing only the
+	// presentation geometry inside the real 3D frustum.
+	CVector delta = originalCenter - cameraPosition;
+	float distance = delta.Magnitude();
+	if(distance <= 0.001f)
+		return;
+
+	float scale = 1.0f;
+	// Native XR uses a 1000-unit far plane.  The 800-unit low-cloud ring
+	// normally fits as-is; retain a little safety margin for high vehicles.
+	const float presentationLimit = 900.0f;
+	if(distance > presentationLimit)
+		scale = presentationLimit/distance;
+
+	const CVector center = cameraPosition + delta*scale;
+	halfWidth *= scale;
+	halfHeight *= scale;
+
+	CVector toCamera = cameraPosition - center;
+	toCamera.Normalise();
+
+	// This basis depends only on the cloud's world direction and global up,
+	// never on the current HMD orientation.  Turning the head can therefore
+	// reveal a different part of the quad without rotating the quad itself.
+	const CVector worldUp(0.0f, 0.0f, 1.0f);
+	CVector stableRight = CrossProduct(worldUp, toCamera);
+	if(stableRight.MagnitudeSqr() <= 0.000001f)
+		stableRight = CVector(1.0f, 0.0f, 0.0f);
+	else
+		stableRight.Normalise();
+	CVector stableUp = CrossProduct(toCamera, stableRight);
+	stableUp.Normalise();
+
+	const float c = Cos(rotation);
+	const float s = Sin(rotation);
+	const CVector right = stableRight*c + stableUp*s;
+	const CVector up = stableUp*c - stableRight*s;
+
+	const CVector offsets[4] = {
+		-right*halfWidth + up*halfHeight,
+		-right*halfWidth - up*halfHeight,
+		 right*halfWidth - up*halfHeight,
+		 right*halfWidth + up*halfHeight
+	};
+	const float u[4] = { 0.0f, 0.0f, 1.0f, 1.0f };
+	const float v[4] = { 0.0f, 1.0f, 1.0f, 0.0f };
+	const int32 firstVertex = batch.vertexCount;
+
+	for(int32 i = 0; i < 4; i++){
+		const CVector position = center + offsets[i];
+		RwIm3DVertex &vertex = batch.vertices[batch.vertexCount++];
+		RwIm3DVertexSetPos(&vertex, position.x, position.y, position.z);
+		RwIm3DVertexSetU(&vertex, u[i]);
+		RwIm3DVertexSetV(&vertex, v[i]);
+
+		// Keep the original two-colour gradient vertical in the world even
+		// while the cloud texture has its own slow rotation.
+		const float vertical = halfHeight > 0.0001f ?
+			DotProduct(offsets[i], stableUp)/halfHeight : 0.0f;
+		const float topFactor = clamp(vertical*0.5f + 0.5f, 0.0f, 1.0f);
+		RwIm3DVertexSetRGBA(&vertex,
+			CloudColourLerp(bottom.r, top.r, topFactor),
+			CloudColourLerp(bottom.g, top.g, topFactor),
+			CloudColourLerp(bottom.b, top.b, topFactor),
+			CloudColourLerp(bottom.a, top.a, topFactor));
+	}
+
+	batch.indices[batch.indexCount++] = firstVertex + 0;
+	batch.indices[batch.indexCount++] = firstVertex + 1;
+	batch.indices[batch.indexCount++] = firstVertex + 2;
+	batch.indices[batch.indexCount++] = firstVertex + 0;
+	batch.indices[batch.indexCount++] = firstVertex + 2;
+	batch.indices[batch.indexCount++] = firstVertex + 3;
+}
+
+static void
