+static uint8
+CloudColourLerp(uint8 bottom, uint8 top, float topFactor)
+{
+	topFactor = clamp(topFactor, 0.0f, 1.0f);
+	return (uint8)(bottom + (top - bottom)*topFactor);
+}
+
+static void
+AddWorldCloudQuad(WorldCloudBatch &batch, const CVector &originalCenter,
+	const CVector &cameraPosition, float halfWidth, float halfHeight,
+	float rotation, const CRGBA &top, const CRGBA &bottom)
+{
+	if(batch.vertexCount + 4 > (int32)ARRAY_SIZE(batch.vertices))
+		return;
