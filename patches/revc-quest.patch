+void
+Idle(void *arg)
+{
+	CTimer::Update();
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfBeginFrame();
+#endif
+
+	tbInit();
+
+	CSprite2d::InitPerFrame();
+	CFont::InitPerFrame();
+
+	PUSH_MEMID(MEMID_GAME_PROCESS);
+	CPointLights::InitPerFrame();
+
+	tbStartTimer(0, "CGame::Process");
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_GAME);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	androidgame::QuestProfilerBeginPhase(
+		androidgame::QUEST_PROFILER_PHASE_GAME);
+#endif
+	CGame::Process();
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	androidgame::QuestProfilerEndPhase(
+		androidgame::QUEST_PROFILER_PHASE_GAME);
+#endif
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_GAME);
+#endif
+	tbEndTimer("CGame::Process");
+	POP_MEMID();
+
+	tbStartTimer(0, "DMAudio.Service");
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_AUDIO);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	androidgame::QuestProfilerBeginPhase(
+		androidgame::QUEST_PROFILER_PHASE_AUDIO);
+#endif
+	DMAudio.Service();
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	androidgame::QuestProfilerEndPhase(
+		androidgame::QUEST_PROFILER_PHASE_AUDIO);
+#endif
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_AUDIO);
+#endif
+	tbEndTimer("DMAudio.Service");
+
+	if(CGame::bDemoMode && CTimer::GetTimeInMilliseconds() > (3*60 + 30)*1000 && !CCutsceneMgr::IsCutsceneProcessing()){
+		WANT_TO_LOAD = false;
+		FrontEndMenuManager.m_bWantToRestart = true;
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfAbortFrame();
+#endif
+		return;
+	}
+
+	if(FrontEndMenuManager.m_bWantToRestart || FOUND_GAME_TO_LOAD)
+	{
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfAbortFrame();
+#endif
+		return;
+	}
+	
+	SetLightsWithTimeOfDayColour(Scene.world);
+
+	if(arg == nil){
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfAbortFrame();
+#endif
+		return;
+	}
+
+	PUSH_MEMID(MEMID_RENDER);
+
+	if(!FrontEndMenuManager.m_bMenuActive && TheCamera.GetScreenFadeStatus() != FADE_2)
+	{
+		// This is from SA, but it's nice for windowed mode
+#if defined(GTA_PC) && !defined(RW_GL3)
+		RwV2d pos;
+		pos.x = SCREEN_WIDTH / 2.0f;
+		pos.y = SCREEN_HEIGHT / 2.0f;
+		RsMouseSetPos(&pos);
+#endif
+
+		tbStartTimer(0, "CnstrRenderList");
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_WORLD_LIST);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerBeginPhase(
+			androidgame::QUEST_PROFILER_PHASE_WORLD_LIST);
+#endif
+#ifdef PC_WATER
+		CWaterLevel::PreCalcWaterGeometry();
+#endif
+#ifdef NEW_RENDERER
+		if(gbNewRenderer){
+			CWorld::AdvanceCurrentScanCode();	// don't think this is even necessary
+			CRenderer::ClearForFrame();
+		}
+#endif
+		CRenderer::ConstructRenderList();
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerEndPhase(
+			androidgame::QUEST_PROFILER_PHASE_WORLD_LIST);
+#endif
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_WORLD_LIST);
+#endif
+		tbEndTimer("CnstrRenderList");
+
+		tbStartTimer(0, "PreRender");
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_PRE_RENDER);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerBeginPhase(
+			androidgame::QUEST_PROFILER_PHASE_PRE_RENDER);
+#endif
+		CRenderer::PreRender();
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerEndPhase(
+			androidgame::QUEST_PROFILER_PHASE_PRE_RENDER);
+#endif
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_PRE_RENDER);
+#endif
+		tbEndTimer("PreRender");
+
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_SCENE_SETUP);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerBeginPhase(
+			androidgame::QUEST_PROFILER_PHASE_SCENE_SETUP);
+#endif
+		bool skipDesktopGameplayRender = false;
+#ifdef GTA_VR_OCULUS
+		// Menus and both kinds of cutscene still need the monitor image for the
+		// cinema layer. During real stereo gameplay the monitor world would be a
+		// third complete render pass, so retain only its inexpensive 2D output.
+		skipDesktopGameplayRender = OculusVR::CanSkipDesktopGameplayRender() &&
+			!TheCamera.m_WideScreenOn &&
+			!CCutsceneMgr::IsCutsceneProcessing() && !CCutsceneMgr::IsRunning();
+#endif
+
+#ifdef FIX_BUGS
+		RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void *)FALSE); // TODO: temp? this fixes OpenGL render but there should be a better place for this
+		// This has to be done BEFORE RwCameraBeginUpdate
+		RwCameraSetFarClipPlane(Scene.camera, CTimeCycle::GetFarClip());
+		RwCameraSetFogDistance(Scene.camera, CTimeCycle::GetFogStart());
+#endif
+
+		if(CWeather::LightningFlash && !CCullZones::CamNoRain()){
+			if(!DoRWStuffStartOfFrame_Horizon(255, 255, 255, 255, 255, 255, 255))
+				goto popret;
+		}else{
+			if(!DoRWStuffStartOfFrame_Horizon(CTimeCycle::GetSkyTopRed(), CTimeCycle::GetSkyTopGreen(), CTimeCycle::GetSkyTopBlue(),
+						CTimeCycle::GetSkyBottomRed(), CTimeCycle::GetSkyBottomGreen(), CTimeCycle::GetSkyBottomBlue(),
+						255))
+				goto popret;
+		}
+
+		DefinedState();
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerEndPhase(
+			androidgame::QUEST_PROFILER_PHASE_SCENE_SETUP);
+#endif
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_SCENE_SETUP);
+#endif
+
+#ifndef FIX_BUGS
+		RwCameraSetFarClipPlane(Scene.camera, CTimeCycle::GetFarClip());
+		RwCameraSetFogDistance(Scene.camera, CTimeCycle::GetFogStart());
+#endif
+
+		tbStartTimer(0, "RenderScene");
+#ifdef GTA_VR_OCULUS
+		if(!skipDesktopGameplayRender)
+			OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_DESKTOP_RENDER);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		if(!skipDesktopGameplayRender)
+			androidgame::QuestProfilerBeginPhase(
+				androidgame::QUEST_PROFILER_PHASE_WORLD_RENDER);
+#endif
+#if defined(GTA_VR_OCULUS) || defined(RW_VULKAN)
+		// ScanWorld deliberately retains a 360 degree safety list for head turns.
+		// Cull that list against this actual view before issuing draw calls.
+		CRenderer::SetVrPerViewCulling(true);
+#endif
+		if(!skipDesktopGameplayRender)
+			RenderScene();
+#if defined(GTA_VR_OCULUS) || defined(RW_VULKAN)
+		CRenderer::SetVrPerViewCulling(false);
+#endif
+		tbEndTimer("RenderScene");
+
+#ifdef EXTENDED_PIPELINES
+		CustomPipes::EnvMapRender();
+#endif
+
+		if(!skipDesktopGameplayRender)
+			RenderDebugShit();
+#ifdef GTA_VR_OCULUS
+		C3dMarkers::SaveStateForStereo();
+#endif
+		if(!skipDesktopGameplayRender)
+			RenderEffects();
+
+		if(!skipDesktopGameplayRender &&
+		   (TheCamera.m_BlurType == MOTION_BLUR_NONE || TheCamera.m_BlurType == MOTION_BLUR_LIGHT_SCENE) &&
+		   TheCamera.m_ScreenReductionPercentage > 0.0f)
+		        TheCamera.SetMotionBlurAlpha(150);
+
+#ifdef SCREEN_DROPLETS
+		if(!skipDesktopGameplayRender){
+			CPostFX::GetBackBuffer(Scene.camera);
+			ScreenDroplets::Process();
+			ScreenDroplets::Render();
+		}
+#endif
+
+		tbStartTimer(0, "RenderMotionBlur");
+#ifndef RW_VULKAN
+		// The blur overlay is a full-screen quad. On the headset "full screen"
+		// is the floating 2D panel, so it shows up as a ghostly rectangle
+		// hanging in the middle of the world instead of a subtle filter.
+		if(!skipDesktopGameplayRender)
+			TheCamera.RenderMotionBlur();
+#endif
+		tbEndTimer("RenderMotionBlur");
+#ifdef GTA_VR_OCULUS
+		if(!skipDesktopGameplayRender)
+			OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_DESKTOP_RENDER);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		if(!skipDesktopGameplayRender)
+			androidgame::QuestProfilerEndPhase(
+				androidgame::QUEST_PROFILER_PHASE_WORLD_RENDER);
+#endif
+
+		tbStartTimer(0, "Render2dStuff");
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_UI);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerBeginPhase(
+			androidgame::QUEST_PROFILER_PHASE_UI);
+#endif
+		Render2dStuff();
+		tbEndTimer("Render2dStuff");
+	}else{
+#ifdef GTA_VR_OCULUS
+		OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_UI);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+		androidgame::QuestProfilerBeginPhase(
+			androidgame::QUEST_PROFILER_PHASE_UI);
+#endif
+		CDraw::CalculateAspectRatio();
+#ifdef ASPECT_RATIO_SCALE
+		CameraSize(Scene.camera, nil, SCREEN_VIEWWINDOW, SCREEN_ASPECT_RATIO);
+#else
+		CameraSize(Scene.camera, nil, SCREEN_VIEWWINDOW, DEFAULT_ASPECT_RATIO);
+#endif
+		CVisibilityPlugins::SetRenderWareCamera(Scene.camera);
+		RwCameraClear(Scene.camera, &gColourTop, CLEARMODE);
+		if(!RsCameraBeginUpdate(Scene.camera))
+			goto popret;
+	}
+
+	tbStartTimer(0, "RenderMenus");
+	RenderMenus();
+	tbEndTimer("RenderMenus");
+
+#ifdef PS2_MENU
+	if ( TheMemoryCard.m_bWantToLoad )
+		goto popret;
+#endif
+
+	tbStartTimer(0, "DoFade");
+	DoFade();
+	tbEndTimer("DoFade");
+
+	tbStartTimer(0, "Render2dStuff-Fade");
+	Render2dStuffAfterFade();
+	tbEndTimer("Render2dStuff-Fade");
+	// CCredits::Render(); // They added it to function above and also forgot it here
+#ifdef XBOX_MESSAGE_SCREEN
+	FrontEndMenuManager.DrawOverlays();
+#endif
+
+	if (gbShowTimebars)
+		tbDisplay();
+
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_UI);
+#endif
+#if defined(RW_VULKAN) && defined(__ANDROID__)
+	androidgame::QuestProfilerEndPhase(
+		androidgame::QUEST_PROFILER_PHASE_UI);
+#endif
+
+	DoRWStuffEndOfFrame();
+
+	POP_MEMID();	// MEMID_RENDER
+
+	if(g_SlowMode) 
+		ProcessSlowMode();
+#ifdef GTA_VR_OCULUS
+	{
+		// Loading a save rebuilds the world in-place.  There is a short, valid
+		// transition after CWorld::Players has been cleared and before GenericLoad
+		// creates the new player ped.  FindPlayerCoors now has a camera fallback,
+		// but a transition frame still has no meaningful player position to record.
+		if(FindPlayerPed()){
+			const CVector playerPosition = FindPlayerCoors();
+			OculusVR::PerfEndFrame(playerPosition.x, playerPosition.y, playerPosition.z);
+		}else
+			OculusVR::PerfAbortFrame();
+	}
+#endif
+	return;
+
+	popret:	POP_MEMID();	// MEMID_RENDER
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfAbortFrame();
+#endif
+}
