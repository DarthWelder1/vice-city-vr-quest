+
+bool CStream::StartPrepared()
+{
+	if ( m_pPreparedBuffer == nil || m_nPreparedBufferCount == 0 )
+		return false;
+	if ( !Setup(false, false) )
+		return false;
+
+	const uint32 bufferSize = m_pSoundFile->GetBufferSize();
+	int32 queued = 0;
+	for ( int32 i = 0; i < m_nPreparedBufferCount; i++ )
+	{
+		const void *data = (const uint8*)m_pPreparedBuffer + (size_t)bufferSize * i;
+		if ( !UploadBuffer(&m_alBuffers[i*2], data, m_aPreparedBufferSizes[i]) )
+			break;
+		alSourceQueueBuffers(m_pAlSources[0], 1, &m_alBuffers[i*2]);
+		alSourceQueueBuffers(m_pAlSources[1], 1, &m_alBuffers[i*2+1]);
+		queued++;
+	}
+
+	free(m_pPreparedBuffer);
+	m_pPreparedBuffer = nil;
+	m_nPreparedBufferCount = 0;
+	memset(m_aPreparedBufferSizes, 0, sizeof(m_aPreparedBufferSizes));
+
+	if ( queued == 0 )
+		return false;
+	SetPlay(true);
+	return true;
