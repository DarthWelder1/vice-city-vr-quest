+static CPed*
+FindVrKatanaHeadTarget(CPlayerPed *player, float strikeSpeed,
+	const CVector &rootStart, const CVector &rootEnd,
+	const CVector &tipStart, const CVector &tipEnd, CVector *impact,
+	CPed *preferredTarget = nil)
+{
+	if(!player || !impact)
+		return nil;
+	CPed *best = nil;
+	float bestDistanceSqr = 1000000.0f;
+	CEntity *savedIgnoreEntity = CWorld::pIgnoreEntity;
+	CWorld::pIgnoreEntity = player;
+	// Test the exact pending physical target first.  This matters immediately
+	// after a hospital teleport, before Vice City's 16-frame near-ped list catches
+	// up, and also avoids losing a head upgrade at the edge of that list.
+	for(int index = -1; index < player->m_numNearPeds; index++){
+		CPed *candidate = index < 0 ? preferredTarget : player->m_nearPeds[index];
+		if(index >= 0 && candidate == preferredTarget)
+			continue;
+		if(!candidate || !IsVrKatanaHeadStrike(candidate, strikeSpeed,
+		   rootStart, rootEnd, tipStart, tipEnd))
+			continue;
+		const CVector head = candidate->GetNodePosition(PED_HEAD)+
+			CVector(0.0f, 0.0f, 0.05f);
+		CColPoint visibilityPoint;
+		CEntity *first = nil;
+		const bool visibilityHit = CWorld::ProcessLineOfSight(rootEnd, head,
+			visibilityPoint, first, true, true, true, true, true,
+			false, false, false);
+		if(visibilityHit && first != candidate)
+			continue;
+		const float distanceSqr = (head-rootEnd).MagnitudeSqr();
+		if(distanceSqr < bestDistanceSqr){
+			best = candidate;
+			bestDistanceSqr = distanceSqr;
+			*impact = head;
+		}
+	}
+	CWorld::pIgnoreEntity = savedIgnoreEntity;
+	return best;
+}
