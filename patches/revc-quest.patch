+static const int gVrCycleBikeModels[] = {
+	MI_ANGEL, MI_FREEWAY, MI_PCJ600,
+	MI_FAGGIO, MI_PIZZABOY, MI_SANCHEZ
+};
+static int gVrCycleBikeIndex;
+static int gVrCycleCarCursor = MI_FIRST_VEHICLE;
+
+static bool
+IsVrCycleCarModel(int model)
+{
+	switch(model){
+	case MI_RCBANDIT:
+	case MI_HUNTER:
+	case MI_CHOPPER:
+	case MI_SEASPAR:
+	case MI_AIRTRAIN:
+	case MI_DEADDODO:
+	case MI_SKIMMER:
+	case MI_RCBARON:
+	case MI_RCRAIDER:
+	case MI_SPARROW:
+	case MI_MAVERICK:
+	case MI_VCNMAV:
+	case MI_POLMAV:
+	case MI_RCGOBLIN:
+		return false;
+	default:
+		break;
+	}
+	CBaseModelInfo *base = CModelInfo::GetModelInfo(model);
+	if(!base)
+		return false;
+	CVehicleModelInfo *vehicle = (CVehicleModelInfo*)base;
+	return vehicle->m_vehicleType == VEHICLE_TYPE_CAR;
+}
+
+static int
+FindVrCycleCarModel(int start)
+{
+	const int count = MI_LAST_VEHICLE-MI_FIRST_VEHICLE+1;
+	int model = Min(Max(start, (int)MI_FIRST_VEHICLE),
+		(int)MI_LAST_VEHICLE);
+	for(int checked = 0; checked < count; checked++){
+		if(IsVrCycleCarModel(model))
+			return model;
+		model++;
+		if(model > MI_LAST_VEHICLE)
+			model = MI_FIRST_VEHICLE;
+	}
+	return -1;
+}
+
+const char *
+GetVrVehicleModelName(int model)
+{
+	CBaseModelInfo *modelInfo =
+		model >= MI_FIRST_VEHICLE && model <= MI_LAST_VEHICLE ?
+		CModelInfo::GetModelInfo(model) : nil;
+	return modelInfo && modelInfo->GetModelName() ?
+		modelInfo->GetModelName() : "UNKNOWN";
+}
+
+int GetVrCheatCount(void)
+{
+	return 2+ARRAY_SIZE(gVrCheatNames);
+}
+
+const char *GetVrCheatName(int index)
+{
+	static char carName[64];
+	static char bikeName[64];
+	if(index == 0){
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor);
+		sprintf(carName, "SPAWN NEXT CAR - %s",
+			GetVrVehicleModelName(model));
+		return carName;
+	}
+	if(index == 1){
+		const int model =
+			gVrCycleBikeModels[gVrCycleBikeIndex %
+				ARRAY_SIZE(gVrCycleBikeModels)];
+		sprintf(bikeName, "SPAWN NEXT MOTORCYCLE - %s",
+			GetVrVehicleModelName(model));
+		return bikeName;
+	}
+	index -= 2;
+	return index >= 0 && index < (int)ARRAY_SIZE(gVrCheatNames) ?
+		gVrCheatNames[index] : "UNKNOWN";
+}
+
+const char *GetVrCurrentWeaponName(void)
+{
+	CPed *player = FindPlayerPed();
+	if(!player || !player->GetWeapon())
+		return "NONE";
+	return CWeaponInfo::GetWeaponName(player->GetWeapon()->m_eWeaponType);
+}
+
+const char *GetVrWeaponName(int weaponType)
+{
+	if(weaponType < 0 || weaponType >= WEAPONTYPE_TOTALWEAPONS)
+		return "NONE";
+	return CWeaponInfo::GetWeaponName((eWeaponType)weaponType);
+}
+
+int GetVrCurrentWeaponType(void)
+{
+	CPed *player = FindPlayerPed();
+	return player && player->GetWeapon() ? (int)player->GetWeapon()->m_eWeaponType : -1;
+}
+
+int GetVrWeaponTypeForSlot(int slot)
+{
+	CPed *player = FindPlayerPed();
+	if(!player || slot < 0 || slot >= TOTAL_WEAPON_SLOTS)
+		return -1;
+	return (int)player->GetWeapon(slot).m_eWeaponType;
+}
+
+bool IsVrWeaponSlotOwned(int slot)
+{
+	CPlayerPed *player = FindPlayerPed();
+	return player && slot >= 0 && slot < TOTAL_WEAPON_SLOTS &&
+		player->HasWeaponSlot(slot);
+}
+
+bool ActivateVrCheat(int index)
+{
+	if(index == 0){
+		if(!FindPlayerPed())
+			return false;
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor);
+		if(model < 0)
+			return false;
+		VehicleCheat(model);
+		gVrCycleCarCursor = model < MI_LAST_VEHICLE ?
+			model+1 : MI_FIRST_VEHICLE;
+		return true;
+	}
+	if(index == 1){
+		if(!FindPlayerPed())
+			return false;
+		const int model =
+			gVrCycleBikeModels[gVrCycleBikeIndex %
+				ARRAY_SIZE(gVrCycleBikeModels)];
+		VehicleCheat(model);
+		gVrCycleBikeIndex =
+			(gVrCycleBikeIndex+1) % ARRAY_SIZE(gVrCycleBikeModels);
+		return true;
+	}
+	const int legacyIndex = index-2;
+	// Weather and time-of-day effects are harmless before a player exists; all
+	// other cheats are deliberately rejected while in the front end.
+	if(!FindPlayerPed() && !(legacyIndex >= 38 && legacyIndex <= 43))
+		return false;
+	switch(legacyIndex){
+	case 0: WeaponCheat1(); break;
+	case 1: WeaponCheat2(); break;
+	case 2: WeaponCheat3(); break;
+	case 3: HealthCheat(); break;
+	case 4: ArmourCheat(); break;
+	case 5: MoneyCheat(); break;
+	case 6: WantedLevelUpCheat(); break;
