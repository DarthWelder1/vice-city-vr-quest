+void CReplay::MarkEverythingAsNew(void)
+{
+	CVehiclePool *vehiclePool = CPools::GetVehiclePool();
+	if (vehiclePool) {
+		int i = vehiclePool->GetSize();
+		while (--i >= 0) {
+			CVehicle* v = vehiclePool->GetSlot(i);
+			if (!v)
+				continue;
+			v->bHasAlreadyBeenRecorded = false;
+		}
+	}
+
+	CPedPool *pedPool = CPools::GetPedPool();
+	if (pedPool) {
+		int i = pedPool->GetSize();
+		while (--i >= 0) {
+			CPed* p = pedPool->GetSlot(i);
+			if (!p)
+				continue;
+			p->bHasAlreadyBeenRecorded = false;
+		}
+	}
+}
 
