+	CameraSize(Scene.camera, nil, SCREEN_VIEWWINDOW, SCREEN_ASPECT_RATIO);
+	RE3_CHECKPOINT("StartOfFrame/SetRenderWareCamera");
+	CVisibilityPlugins::SetRenderWareCamera(Scene.camera);
+	RE3_CHECKPOINT("StartOfFrame/CameraClear");
+	RwCameraClear(Scene.camera, &TopColor.rwRGBA, CLEARMODE);
+
+	RE3_CHECKPOINT("StartOfFrame/CameraBeginUpdate");
+	if(!RsCameraBeginUpdate(Scene.camera))
+		return false;
+
+	RE3_CHECKPOINT("StartOfFrame/InitPerFrame");
+	CSprite2d::InitPerFrame();
+
+	if(Alpha != 0){
+		RE3_CHECKPOINT("StartOfFrame/DrawRect");
+		CSprite2d::DrawRect(CRect(0.0f, 0.0f, SCREEN_WIDTH, SCREEN_HEIGHT), BottomColor, BottomColor, TopColor, TopColor);
