+static void
+RenderVrCarSteeringWheel(void)
+{
+	if(!OculusVR::IsVrCarDrivingActive())
+		return;
+	CMatrix leftHandle, rightHandle;
+	if(!OculusVR::GetImmersiveSteeringHandleMatrix(0, &leftHandle) ||
+	   !OculusVR::GetImmersiveSteeringHandleMatrix(1, &rightHandle))
+		return;
+
+	CVector normal = leftHandle.GetForward()+rightHandle.GetForward();
+	if(normal.MagnitudeSqr() < 0.0001f)
+		return;
+	normal.Normalise();
+	CVector wheelRight =
+		rightHandle.GetPosition()-leftHandle.GetPosition();
+	wheelRight -= normal*DotProduct(wheelRight, normal);
+	const float gripSpan = wheelRight.Magnitude();
+	if(gripSpan < 0.10f)
+		return;
+	wheelRight *= 1.0f/gripSpan;
+	CVector wheelUp = CrossProduct(wheelRight, normal);
+	if(wheelUp.MagnitudeSqr() < 0.0001f)
+		return;
+	wheelUp.Normalise();
+	// Vice City bakes the cabin steering wheel into chassis_hi, so there is no
+	// frame that can be animated. Draw a depth-tested calibrated VR wheel just
+	// in front of it; its basis comes from the same sockets as the rendered
+	// hands, guaranteeing that wheel and hands always turn together.
+	const float radius = Max(0.12f, Min(gripSpan*0.5f, 0.32f));
+	const CVector center =
+		(leftHandle.GetPosition()+rightHandle.GetPosition())*0.5f-
+		normal*0.018f;
+	enum { WHEEL_SEGMENTS = 24, WHEEL_BOXES = WHEEL_SEGMENTS+4 };
+	RwIm3DVertex vertices[WHEEL_BOXES*8];
+	RwImVertexIndex indices[WHEEL_BOXES*36];
+	int vertexCount = 0, indexCount = 0;
+	for(int segment = 0; segment < WHEEL_SEGMENTS; segment++){
+		const float angle0 = TWOPI*(float)segment/(float)WHEEL_SEGMENTS;
+		const float angle1 = TWOPI*(float)(segment+1)/(float)WHEEL_SEGMENTS;
+		const CVector start = center+
+			wheelRight*(cosf(angle0)*radius)+
+			wheelUp*(sinf(angle0)*radius);
+		const CVector end = center+
+			wheelRight*(cosf(angle1)*radius)+
+			wheelUp*(sinf(angle1)*radius);
+		CVector tangent = end-start;
+		const float length = tangent.Magnitude();
+		if(length < 0.001f)
+			continue;
+		tangent *= 1.0f/length;
+		CVector radial = (start+end)*0.5f-center;
+		radial.Normalise();
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			(start+end)*0.5f, tangent, radial, normal,
+			length*0.52f, 0.014f, 0.012f, 32, 34, 38);
+	}
+	for(int spoke = 0; spoke < 3; spoke++){
+		const float angle = TWOPI*(float)spoke/3.0f;
+		CVector direction =
+			wheelRight*cosf(angle)+wheelUp*sinf(angle);
+		direction.Normalise();
+		const float spokeLength = radius*0.72f;
+		CVector spokeSide = CrossProduct(normal, direction);
+		spokeSide.Normalise();
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			center+direction*(spokeLength*0.5f),
+			direction, spokeSide, normal,
+			spokeLength*0.5f, 0.012f, 0.010f, 46, 48, 53);
+	}
+	AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+		center, wheelRight, wheelUp, normal,
+		0.050f, 0.050f, 0.018f, 40, 42, 47);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	if(GameRender::BeginImmediate3D(vertices, vertexCount, nil,
+	   rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA,
+	   GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+		GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST,
+			indices, indexCount);
+		GameRender::EndImmediate3D();
+	}
+}
