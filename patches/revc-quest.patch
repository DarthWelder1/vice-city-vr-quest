+void
+DoRWStuffEndOfFrame(void)
+{
+	CDebug::DisplayScreenStrings();	// custom
+	CDebug::DebugDisplayTextBuffer();
+	FlushObrsPrintfs();
+	RwCameraEndUpdate(Scene.camera);
+#ifdef GTA_VR_OCULUS
+	// Formal cutscenes use CCutsceneMgr, while scripted cinematics (including the
+	// opening drive to the hotel) only enable the game's widescreen camera mode.
+	// Keep both kinds on the mono cinema layer for their entire transition.
+	const bool cutsceneProcessing = CCutsceneMgr::IsCutsceneProcessing();
+	const bool cutsceneRunning = CCutsceneMgr::IsRunning();
+	const bool cutscenePreparing = cutsceneProcessing && !cutsceneRunning;
+	bool newGameCinemaHold = OculusVR::IsNewGameCinemaHoldActive();
+	if(newGameCinemaHold &&
+	   (FrontEndMenuManager.m_bGameNotLoaded || FrontEndMenuManager.m_bMenuActive)){
+		OculusVR::EndNewGameCinemaHold();
+		newGameCinemaHold = false;
+	}
+	// LoadCutsceneData can already have stripped the current world while the
+	// cutscene camera is not ready. Only widescreen/running confirms a safe
+	// first cinema image.
+	if(newGameCinemaHold && (cutsceneRunning || TheCamera.m_WideScreenOn)){
+		OculusVR::EndNewGameCinemaHold();
+		newGameCinemaHold = false;
+	}
+	// LoadingScreen also reaches this function while InitialiseWhenRestarting
+	// has already destroyed the old world but has not restored PlayerInfo yet.
+	// Never treat those frames as live stereo gameplay: preserve the cinema
+	// loading image until the restart/load transaction has fully completed.
+	const bool showGameplay = !FrontEndMenuManager.m_bGameNotLoaded &&
+		!FrontEndMenuManager.m_bMenuActive &&
+		!FrontEndMenuManager.m_bWantToRestart &&
+		!FrontEndMenuManager.m_bWantToLoad &&
+		FindPlayerPed() != nil &&
+		!TheCamera.m_WideScreenOn &&
+		!cutsceneProcessing && !cutsceneRunning && !newGameCinemaHold;
+	if(showGameplay)
+		RenderVrStereoFrame();
+	else{
+		OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_CINEMA_SUBMIT);
+		// LoadCutsceneData removes the current zone before SetupCutsceneToStart
+		// marks the next scene as running. Hold the last released cinema image in
+		// that gap instead of exposing the stripped world for one frame.
+		OculusVR::SubmitCinemaFrame(Scene.camera,
+			cutscenePreparing || newGameCinemaHold);
+		OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_CINEMA_SUBMIT);
+	}
+#endif
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_DESKTOP_PRESENT);
+#endif
+	RsCameraShowRaster(Scene.camera);
+#ifdef GTA_VR_OCULUS
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_DESKTOP_PRESENT);
+#endif
+#ifndef MASTER
+	char s[48];
+#ifdef THIS_IS_STUPID
+	if (CPad::GetPad(1)->GetLeftShockJustDown()) {
+		// try using both controllers for this thing... crazy bastards
+		if (CPad::GetPad(0)->GetRightStickY() > 0) {
+			sprintf(s, "screen%d%d.ras", CClock::ms_nGameClockHours, CClock::ms_nGameClockMinutes);
+			// TODO
+			//RtTileRender(Scene.camera, TILE_WIDTH * 2, TILE_HEIGHT * 2, TILE_WIDTH, TILE_HEIGHT, &NewTileRendererCB, nil, s);
+		} else {
+			sprintf(s, "screen%d%d.bmp", CClock::ms_nGameClockHours, CClock::ms_nGameClockMinutes);
+			RwGrabScreen(Scene.camera, s);
+		}
+	}
+#else
+	if (CPad::GetPad(1)->GetLeftShockJustDown() || CPad::GetPad(0)->GetFJustDown(11)) {
+		sprintf(s, "screen_%11lld.png", time(nil));
+		RwGrabScreen(Scene.camera, s);
+	}
+#endif
+#endif // !MASTER
+}
