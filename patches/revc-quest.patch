+static void
+ClearVrPendingKatanaBodyHit(int hand)
+{
+	if(hand < 0 || hand >= 2)
+		return;
+	VrPendingKatanaBodyHit &pending = gVrPendingKatanaBodyHit[hand];
+	if(pending.target)
+		pending.target->CleanUpOldReference(&pending.target);
+	pending = VrPendingKatanaBodyHit();
+}
+
+static void
+SaveVrPendingKatanaBodyHit(int hand, CPlayerPed *owner, int slot,
+	int weaponType, CEntity *target, const CVector &impact,
+	const CColPoint &contact, uint32 now, uint32 frame)
+{
+	if(hand < 0 || hand >= 2 || !owner || !target || !target->IsPed())
+		return;
+	ClearVrPendingKatanaBodyHit(hand);
+	VrPendingKatanaBodyHit &pending = gVrPendingKatanaBodyHit[hand];
+	pending.active = true;
+	pending.owner = owner;
+	pending.target = target;
+	pending.slot = slot;
+	pending.weaponType = weaponType;
+	pending.impact = impact;
+	pending.contact = contact;
+	pending.startedAt = now;
+	pending.lastProcessFrame = frame;
+	target->RegisterReference(&pending.target);
+}
