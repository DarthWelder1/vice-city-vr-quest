+
+bool ActivateVrCheat(int index)
+{
+	if(index == 0)
+		return PassCurrentVrMission();
+	index--;
+	if(index == 0){
+		if(!FindPlayerPed())
+			return false;
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor);
+		if(model < 0)
+			return false;
+		VehicleCheat(model);
+		gVrCycleCarCursor = model < MI_LAST_VEHICLE ?
+			model+1 : MI_FIRST_VEHICLE;
+		return true;
+	}
+	if(index == 1){
+		if(!FindPlayerPed())
+			return false;
+		const int model =
+			gVrCycleBikeModels[gVrCycleBikeIndex %
+				ARRAY_SIZE(gVrCycleBikeModels)];
+		VehicleCheat(model);
+		gVrCycleBikeIndex =
+			(gVrCycleBikeIndex+1) % ARRAY_SIZE(gVrCycleBikeModels);
+		return true;
+	}
+	if(index == 2){
+		if(!FindPlayerPed())
+			return false;
+		SetVrGodMode(!gVrGodModeEnabled);
+		return true;
+	}
+	const int legacyIndex = index-3;
+	// Weather and time-of-day effects are harmless before a player exists; all
+	// other cheats are deliberately rejected while in the front end.
+	if(!FindPlayerPed() && !(legacyIndex >= 38 && legacyIndex <= 43))
+		return false;
+	switch(legacyIndex){
+	case 0: WeaponCheat1(); break;
+	case 1: WeaponCheat2(); break;
+	case 2: WeaponCheat3(); break;
+	case 3: HealthCheat(); break;
