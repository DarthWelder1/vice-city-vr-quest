+	if(weaponType < 0 || weaponType >= WEAPONTYPE_TOTALWEAPONS)
+		return nil;
+	CWeaponInfo *weaponInfo = CWeaponInfo::GetWeaponInfo((eWeaponType)weaponType);
+	if(weaponInfo == nil)
+		return nil;
+	if(weaponInfo->m_nModelId <= 0)
+		return weaponType < NUM_HUD_SPRITES ? Sprites[weaponType].m_pTexture : nil;
+
+	CBaseModelInfo *weaponModel = CModelInfo::GetModelInfo(weaponInfo->m_nModelId);
+	if(weaponModel == nil)
+		return nil;
+	const int txdSlot = weaponModel->GetTxdSlot();
+	if(txdSlot < 0)
+		return nil;
+	TxdDef *txd = CTxdStore::GetSlot(txdSlot);
+	return txd && txd->texDict ?
+		RwTexDictionaryFindNamedTexture(txd->texDict, weaponModel->GetModelName()) : nil;
+}
