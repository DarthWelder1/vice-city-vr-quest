+			// Other melee roots still sit at the hand and intentionally omit their
+			// first sample to keep the handle from becoming a damaging volume.
+			const float along = isKatana ?
+				(float)sample/(float)(shaftSamples-1) :
+				(float)(sample+1)/(float)shaftSamples;
+			const CVector previousPoint = previousRoot+
