+			return true;	// camera-anchored frames draw everything
+		if(ent->bIsBIGBuilding)
+			return true;
+		// The entity position is the model origin, which for road pieces can
+		// sit tens of metres from the mesh under the player's feet. Slack the
+		// test by the bounding radius or the ground gets culled in patches.
+		const float radius = ent->GetBoundRadius();
+		const CVector to = ent->GetPosition() - ms_vecCameraPosition;
+		const float d2 = to.x*to.x + to.y*to.y;
+		if(d2 < SQR(20.0f + radius))
+			return true;
+		float ang = Atan2(to.y, to.x) - viewYaw;
+		while(ang > PI) ang -= TWOPI;
+		while(ang < -PI) ang += TWOPI;
+		const float dist = Sqrt(d2);
+		const float slack = Asin(Min(1.0f, radius/dist));
