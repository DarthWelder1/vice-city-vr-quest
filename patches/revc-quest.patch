+	// The original clouds are screen sprites and therefore ignore the world
+	// far plane.  Preserve their apparent angular size while bringing only the
+	// presentation geometry inside the real 3D frustum.
+	CVector delta = originalCenter - cameraPosition;
+	float distance = delta.Magnitude();
+	if(distance <= 0.001f)
+		return;
