+{
+	RpGeometry *geometry = RpAtomicGetGeometry(atomic);
+	if(geometry == nil)
+		return atomic;
+
+	// Cutscene character DFFs are lit and have no prelight.  Their materials
+	// are already white, and the classic Android transparency workaround only
+	// needs them opaque.  Forcing MODULATE on just the first atomic made the
+	// Vulkan skin path depend on a zero cutscene-light value and left every
+	// actor black.  Restore every atomic to the DFF's non-modulated state.
+	RpGeometrySetFlags(geometry,
