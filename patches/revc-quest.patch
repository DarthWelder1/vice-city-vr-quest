+static bool
+PassCurrentVrMission(void)
+{
+	if(!FindPlayerPed() || !CTheScripts::IsPlayerOnAMission())
+		return false;
+
+	for(CRunningScript *script = CTheScripts::pActiveScripts;
+	    script; script = script->GetNext()){
+		if(!script->m_bIsActive || !script->m_bIsMissionScript ||
+		   !script->m_bMissionFlag || script->m_nStackPointer < 1)
+			continue;
+		for(int i = 0; i < (int)ARRAY_SIZE(gVrMissionPassEntries); i++){
+			const VrMissionPassEntry &entry = gVrMissionPassEntries[i];
+			if(strncmp(script->m_abScriptName, entry.scriptName,
+			   KEY_LENGTH_IN_SCRIPT) != 0)
+				continue;
+			const uint32 target =
+				SIZE_MAIN_SCRIPT+(uint32)entry.successOffset;
+			if(target+1 >= SIZE_SCRIPT_SPACE)
+				return false;
+			const uint16 targetCommand =
+				(CTheScripts::ScriptSpace[target] |
+				 (CTheScripts::ScriptSpace[target+1] << 8)) & 0x7FFF;
+			if(targetCommand != entry.expectedCommand)
+				return false;
+			while(script->m_nStackPointer > 1)
+				--script->m_nStackPointer;
+			script->SetIP(target);
+			script->m_nWakeTime = 0;
+			script->m_bSkipWakeTime = false;
+			script->m_bCondResult = false;
+			script->m_bNotFlag = false;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+ApplyVrGodMode(void)
+{
+	if(!gVrGodModeEnabled)
+		return;
+	CPlayerPed *player = FindPlayerPed();
+	if(!player)
+		return;
+	player->m_fHealth = Max(player->m_fHealth,
+		(float)CWorld::Players[CWorld::PlayerInFocus].m_nMaxHealth);
+	player->bBulletProof = true;
+	player->bFireProof = true;
+	player->bCollisionProof = true;
+	player->bMeleeProof = true;
+	player->bExplosionProof = true;
+	player->m_bCanBeDamaged = false;
+	CWorld::Players[CWorld::PlayerInFocus].m_bFireproof = true;
+}
+
+static void
+SetVrGodMode(bool enabled)
+{
+	gVrGodModeEnabled = enabled;
+	CPlayerPed *player = FindPlayerPed();
+	if(!player)
+		return;
+	if(enabled){
+		ApplyVrGodMode();
+		return;
+	}
+	player->bBulletProof = false;
+	player->bFireProof = false;
+	player->bCollisionProof = false;
+	player->bMeleeProof = false;
+	player->bExplosionProof = false;
+	player->m_bCanBeDamaged = true;
+	CWorld::Players[CWorld::PlayerInFocus].m_bFireproof = false;
+}
