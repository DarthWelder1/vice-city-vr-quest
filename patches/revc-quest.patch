+const char *GetVrCheatName(int index)
+{
+	static char carName[64];
+	static char bikeName[64];
+	if(index == 0)
+		return "PASS CURRENT MISSION";
+	index--;
+	if(index == 0){
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor);
+		sprintf(carName, "SPAWN NEXT CAR - %s",
+			GetVrVehicleModelName(model));
+		return carName;
+	}
+	if(index == 1){
+		const int model =
+			gVrCycleBikeModels[gVrCycleBikeIndex %
+				ARRAY_SIZE(gVrCycleBikeModels)];
+		sprintf(bikeName, "SPAWN NEXT MOTORCYCLE - %s",
+			GetVrVehicleModelName(model));
+		return bikeName;
+	}
+	if(index == 2)
+		return gVrGodModeEnabled ?
+			"GOD MODE - ON" : "GOD MODE - OFF";
+	index -= 3;
+	return index >= 0 && index < (int)ARRAY_SIZE(gVrCheatNames) ?
+		gVrCheatNames[index] : "UNKNOWN";
+}
