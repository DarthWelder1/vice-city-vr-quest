+		-right*halfWidth - up*halfHeight,
+		 right*halfWidth - up*halfHeight,
+		 right*halfWidth + up*halfHeight
+	};
+	const float u[4] = { 0.0f, 0.0f, 1.0f, 1.0f };
+	const float v[4] = { 0.0f, 1.0f, 1.0f, 0.0f };
