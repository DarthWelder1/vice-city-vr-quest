+		const float t = (float)step/(float)steps;
+		const CVector previousRoot = rootStart+rootTravel*previousT;
+		const CVector previousTip = tipStart+tipTravel*previousT;
+		const CVector root = rootStart+rootTravel*t;
+		const CVector tip = tipStart+tipTravel*t;
