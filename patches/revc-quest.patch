+bool CStream::Prepare(uint32 nPos)
+{
+	if ( !IsOpened() )
+		return false;
+
+	if ( m_pPreparedBuffer )
+	{
+		free(m_pPreparedBuffer);
+		m_pPreparedBuffer = nil;
+	}
+	m_nPreparedBufferCount = 0;
+	memset(m_aPreparedBufferSizes, 0, sizeof(m_aPreparedBufferSizes));
+
+	const uint32 bufferSize = m_pSoundFile->GetBufferSize();
+	const int32 bufferCount = NUM_STREAMBUFFERS / 2;
+	m_pPreparedBuffer = malloc((size_t)bufferSize * bufferCount);
+	if ( m_pPreparedBuffer == nil )
+		return false;
+
+	m_pSoundFile->Seek(0);
+	if ( nPos != 0 )
+		m_pSoundFile->Seek(nPos);
+
+	for ( int32 i = 0; i < bufferCount; i++ )
+	{
+		void *target = (uint8*)m_pPreparedBuffer + (size_t)bufferSize * i;
+		uint32 size = m_pSoundFile->Decode(target);
+		if ( size == 0 )
+			break;
+		m_aPreparedBufferSizes[i] = size;
+		m_nPreparedBufferCount++;
+	}
+
+	return m_nPreparedBufferCount != 0;
