+#if defined(GTA_VR_OCULUS) || defined(GTA_VR_WEAPONS)
+static CVector
+GetVrVehicleBulletTraceSource(CVehicle *vehicle, const CVector &source,
+	const CVector &direction)
+{
+	if(!vehicle || direction.MagnitudeSqr() < 0.0001f)
+		return source;
+
+	CVector worldDirection = direction;
+	worldDirection.Normalise();
+	CMatrix inverseVehicle;
+	Invert(vehicle->GetMatrix(), inverseVehicle);
+	const CVector localSource = inverseVehicle*source;
+	const CVector localDirection =
+		Multiply3x3(inverseVehicle, worldDirection);
+	const CBox &box = vehicle->GetColModel()->boundingBox;
+	const float margin = 0.04f;
+	if(localSource.x < box.min.x-margin ||
+	   localSource.x > box.max.x+margin ||
+	   localSource.y < box.min.y-margin ||
+	   localSource.y > box.max.y+margin ||
+	   localSource.z < box.min.z-margin ||
+	   localSource.z > box.max.z+margin)
+		return source;
+
+	float exitDistance = 1000000.0f;
+	if(Abs(localDirection.x) > 0.0001f){
+		const float boundary = localDirection.x > 0.0f ?
+			box.max.x+margin : box.min.x-margin;
+		const float distance =
+			(boundary-localSource.x)/localDirection.x;
+		if(distance >= 0.0f)
+			exitDistance = Min(exitDistance, distance);
+	}
+	if(Abs(localDirection.y) > 0.0001f){
+		const float boundary = localDirection.y > 0.0f ?
+			box.max.y+margin : box.min.y-margin;
+		const float distance =
+			(boundary-localSource.y)/localDirection.y;
+		if(distance >= 0.0f)
+			exitDistance = Min(exitDistance, distance);
+	}
+	if(Abs(localDirection.z) > 0.0001f){
+		const float boundary = localDirection.z > 0.0f ?
+			box.max.z+margin : box.min.z-margin;
+		const float distance =
+			(boundary-localSource.z)/localDirection.z;
+		if(distance >= 0.0f)
+			exitDistance = Min(exitDistance, distance);
+	}
+	if(exitDistance >= 1000000.0f)
+		return source;
+
+	// Damage still traces from the real tracked muzzle while ignoring only the
+	// player's vehicle. Move the cosmetic bullet streak beyond the car bounds
+	// so side-window shots are visible instead of beginning inside the body.
+	return source+worldDirection*(exitDistance+0.05f);
+}
