+// Draw only the persistent gameplay interface into the already post-processed
+// Oculus eye texture. Keeping it separate from Render2dStuff avoids processing
+// messages, timers and debug UI once per eye.
+void
+RenderVrGameplayHud(void)
+{
+	PUSH_RENDERGROUP("RenderVrGameplayHud");
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	// Oculus quad layers expect premultiplied RGB with a regular coverage alpha.
+	// RenderWare normally applies the RGB blend factors to alpha as well, which
+	// would square translucent HUD alpha on a transparent target.
+	#ifdef RW_GL3
+	glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+	#endif
+	const bool trackedScope = OculusVR::IsTrackedScopeActive();
+	const int trackedScopeWeapon = OculusVR::GetTrackedScopeWeaponType();
+	if(trackedScope && trackedScopeWeapon != WEAPONTYPE_CAMERA){
+		// The native sniper/RPG mask is normally drawn by Render2dStuff into the
+		// desktop backbuffer. Recreate it in the dedicated OpenXR HUD layer so the
+		// optical crop has no distracting zoomed periphery.
+		const CRGBA black(0, 0, 0, 255);
+		const bool rocket = trackedScopeWeapon == WEAPONTYPE_ROCKETLAUNCHER;
+		const float vertical = rocket ? SCREEN_SCALE_Y(180.0f) :
+			SCREEN_SCALE_Y(210.0f);
+		const float lowerVertical = rocket ? SCREEN_SCALE_Y(170.0f) :
+			SCREEN_SCALE_Y(210.0f);
+		CSprite2d::DrawRect(CRect(0.0f, 0.0f, SCREEN_WIDTH,
+			SCREEN_HEIGHT/2.0f-vertical), black);
+		CSprite2d::DrawRect(CRect(0.0f,
+			SCREEN_HEIGHT/2.0f+lowerVertical, SCREEN_WIDTH, SCREEN_HEIGHT), black);
+		CSprite2d::DrawRect(CRect(0.0f, 0.0f,
+			SCREEN_WIDTH/2.0f-SCREEN_SCALE_X(210.0f), SCREEN_HEIGHT), black);
+		CSprite2d::DrawRect(CRect(
+			SCREEN_WIDTH/2.0f+SCREEN_SCALE_X(210.0f), 0.0f,
+			SCREEN_WIDTH, SCREEN_HEIGHT), black);
+	}
+	CHud::Draw();
+	if(!trackedScope)
+		CFont::DrawFonts();
+	#ifdef RW_GL3
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	#endif
+	POP_RENDERGROUP();
+}
+
+static void
+RenderVrStereoFrame(void)
+{
+	CMatrix originalCamera = TheCamera.GetMatrix();
+	CMatrix vrBaseCamera = originalCamera;
+	if(OculusVR::IsFirstPersonEnabled()){
+		CPed *player = FindPlayerPed();
+		// During death/respawn the CPed pointer can outlive its RenderWare clump.
+		// Bone access in that transition dereferences the missing clump, so use
+		// the game's death camera until a living rendered player exists again.
+		if(player && player->m_rwObject && !player->DyingOrDead() && player->m_pFrames[PED_HEAD]){
+			CVector forward = player->GetForward();
+			CVector up = player->GetUp();
+			forward.Normalise();
+			up.Normalise();
+			CVector left = CrossProduct(up, forward);
+			left.Normalise();
+			up = CrossProduct(forward, left);
+			up.Normalise();
+
+			vrBaseCamera.GetRight() = left;
+			vrBaseCamera.GetForward() = forward;
+			vrBaseCamera.GetUp() = up;
+			// CPed::GetNodePosition returns the skinned bone matrix position without the
+			// world transform. CPedIK uses the component matrix used by reVC's own
+			// first-person cameras, so this is Tommy's actual head position in the world.
+			CVector headPosition(0.0f, 0.0f, 0.0f);
+			player->m_pedIK.GetComponentPosition(headPosition, PED_HEAD);
+			vrBaseCamera.GetPosition() = headPosition + forward * 0.12f;
+		}
+	}
+	const float originalFov = CDraw::GetFOV();
+	if(!OculusVR::BeginStereoFrame(Scene.camera, vrBaseCamera)){
+		OculusVR::SetInactive();
+		return;
+	}
+	C3dMarkers::RestoreStateForStereo();
+
+	bool renderedBothEyes = true;
+	CRenderer::SetVrPerViewCulling(true);
+	#ifdef RW_D3D12
+	renderedBothEyes = RenderVrStereoFrameD3D12(originalFov);
+	#else
+	for(int eye = 0; eye < 2; eye++){
+		OculusVR::PerfBeginPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+		CMatrix eyeCamera;
+		float eyeFov = originalFov;
+		if(!OculusVR::BeginEye(Scene.camera, eye, &eyeCamera, &eyeFov)){
+			OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+			renderedBothEyes = false;
+			break;
+		}
+
+		TheCamera.GetMatrix() = eyeCamera;
+		CDraw::SetFOV(eyeFov);
+		TheCamera.CalculateDerivedValues();
+		CVisibilityPlugins::SetRenderWareCamera(Scene.camera);
+		// The normal renderer only clears depth because its horizon pass covers the
+		// desktop backbuffer. VR camera textures survive across frames and the
+		// asymmetric eye resolve crops their contents, so any uncovered color would
+		// otherwise remain as visible trails while the headset turns.
+		RwCameraClear(Scene.camera, &gColourTop, CLEARMODE | rwCAMERACLEARIMAGE);
+		if(!RwCameraBeginUpdate(Scene.camera)){
+			OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+			renderedBothEyes = false;
+			break;
+		}
+
+		TheCamera.m_viewMatrix.Update();
+		if(CWeather::LightningFlash && !CCullZones::CamNoRain()){
+			CClouds::RenderBackground(255, 255, 255, 255, 255, 255, 255);
+		}else{
+			CClouds::RenderBackground(CTimeCycle::GetSkyTopRed(), CTimeCycle::GetSkyTopGreen(),
+				CTimeCycle::GetSkyTopBlue(), CTimeCycle::GetSkyBottomRed(),
+				CTimeCycle::GetSkyBottomGreen(), CTimeCycle::GetSkyBottomBlue(), 255);
+		}
+
+		DefinedState();
+		RenderScene();
+		C3dMarkers::SetPreserveAfterRender(eye == 0);
+		// Dynamic projected shadows include the additive headlight pools. They are
+		// generated once during PreRender and must survive the left eye just like
+		// bright lights and traffic-light geometry.
+		CShadows::SetPreserveAfterRender(eye == 0);
+		// PreRender builds these transient effect lists once per game frame. Keep
+		// them after the left eye so traffic lights and shiny signs are also
+		// available to the right eye.
+		CBrightLights::SetPreserveAfterRender(eye == 0);
+		CShinyTexts::SetPreserveAfterRender(eye == 0);
+		RenderEffects();
+		RenderVrTrackedHands();
+		RwCameraEndUpdate(Scene.camera);
+		OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+	}
+	#endif
+	CRenderer::SetVrPerViewCulling(false);
+	C3dMarkers::FinishStereoRender();
+	CShadows::FinishStereoRender();
+	CBrightLights::FinishStereoRender();
+	CShinyTexts::FinishStereoRender();
+
+	TheCamera.GetMatrix() = originalCamera;
+	CDraw::SetFOV(originalFov);
+	TheCamera.CalculateDerivedValues();
+
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_SUBMIT);
+	if(renderedBothEyes)
+		OculusVR::SubmitStereoFrame(Scene.camera);
+	else
+		OculusVR::CancelStereoFrame(Scene.camera);
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_SUBMIT);
+}
+#endif
