+static const uint8 *
+FindVrDebugGlyph(char character)
+{
+	for(uint32 i = 0; i < ARRAY_SIZE(gVrDebugGlyphs); i++)
+		if(gVrDebugGlyphs[i].character == character)
+			return gVrDebugGlyphs[i].rows;
+	return gVrDebugGlyphs[0].rows;
+}
+
+static void
+DrawVrDebugText(const char *text, float centerX, float y, float pixel, const CRGBA &color)
+{
+	const float advance = pixel * 6.0f;
+	float x = centerX - strlen(text) * advance * 0.5f;
+	for(const char *character = text; *character; character++, x += advance){
+		const uint8 *rows = FindVrDebugGlyph(*character);
+		for(int row = 0; row < 7; row++)
+			for(int column = 0; column < 5; column++)
+				if(rows[row] & (1 << (4 - column)))
+					CSprite2d::DrawRect(CRect(x + column*pixel, y + row*pixel,
+						x + (column + 1)*pixel, y + (row + 1)*pixel), color);
+	}
+}
