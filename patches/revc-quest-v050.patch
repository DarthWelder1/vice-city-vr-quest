+
+static ModelSets::eModelCategory
+GetModelSetCategory(int modelId)
+{
+	CBaseModelInfo *model = modelId >= 0 && modelId < MODELINFOSIZE ?
+		CModelInfo::GetModelInfo(modelId) : nil;
+	if(!model)
+		return ModelSets::MODEL_CATEGORY_WORLD;
+	switch(model->GetModelType()){
+	case MITYPE_VEHICLE: return ModelSets::MODEL_CATEGORY_VEHICLES;
+	case MITYPE_PED: return ModelSets::MODEL_CATEGORY_PEDS;
+	case MITYPE_WEAPON: return ModelSets::MODEL_CATEGORY_WEAPONS;
+	default: break;
+	}
+	if(ModelSets::IsVegetationModel(model->GetModelName()))
+		return ModelSets::MODEL_CATEGORY_VEGETATION;
+	return ModelSets::MODEL_CATEGORY_WORLD;
+}
+
+static bool
+ShouldUseModernModel(int modelId)
+{
+	const ModelSets::eModelCategory category = GetModelSetCategory(modelId);
+	if(category != ModelSets::MODEL_CATEGORY_WORLD || ModelSets::HasVegetationManifest())
+		return ModelSets::IsCategoryModernActive(category);
+	CBaseModelInfo *model = modelId >= 0 && modelId < MODELINFOSIZE ?
+		CModelInfo::GetModelInfo(modelId) : nil;
+	if(model && (model->GetModelType() == MITYPE_SIMPLE ||
+	   model->GetModelType() == MITYPE_TIME ||
+	   model->GetModelType() == MITYPE_CLUMP))
+		return ModelSets::IsCategoryModernActive(ModelSets::MODEL_CATEGORY_WORLD) &&
+			ModelSets::IsCategoryModernActive(ModelSets::MODEL_CATEGORY_VEGETATION);
+	return ModelSets::IsCategoryModernActive(category);
+}
+
+static bool
+ShouldUseModernTxd(int txdSlot)
+{
+	bool referenced = false;
+	for(int i = 0; i < MODELINFOSIZE; i++){
+		CBaseModelInfo *model = CModelInfo::GetModelInfo(i);
+		if(!model || model->GetTxdSlot() != txdSlot)
+			continue;
+		referenced = true;
+		if(ShouldUseModernModel(i))
+			return true;
+	}
+	return !referenced && ModelSets::IsCategoryModernActive(ModelSets::MODEL_CATEGORY_WORLD);
+}
+
+static bool
+ShouldUseModernArchiveEntry(const char *extension, int modelId)
+{
+	if(strncasecmp(extension, "DFF", 3) == 0)
+		return ShouldUseModernModel(modelId);
+	if(strncasecmp(extension, "TXD", 3) == 0)
+		return ShouldUseModernTxd(modelId-STREAM_OFFSET_TXD);
+	if(strncasecmp(extension, "IFP", 3) == 0)
+		return ModelSets::IsCategoryModernActive(ModelSets::MODEL_CATEGORY_PEDS) ||
+			ModelSets::IsCategoryModernActive(ModelSets::MODEL_CATEGORY_WEAPONS);
+	return ModelSets::IsCategoryModernActive(ModelSets::MODEL_CATEGORY_WORLD);
 }
 
