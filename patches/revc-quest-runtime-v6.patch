+static int
+FindVrCycleCarModelDirection(int start, int direction)
+{
+	const int count = MI_LAST_VEHICLE-MI_FIRST_VEHICLE+1;
+	direction = direction < 0 ? -1 : 1;
+	int model = start;
+	while(model < MI_FIRST_VEHICLE) model += count;
+	while(model > MI_LAST_VEHICLE) model -= count;
+	for(int checked = 0; checked < count; checked++){
+		if(IsVrCycleCarModel(model)) return model;
+		model += direction;
+		if(model > MI_LAST_VEHICLE) model = MI_FIRST_VEHICLE;
+		if(model < MI_FIRST_VEHICLE) model = MI_LAST_VEHICLE;
+	}
+	return -1;
+}
+
+static void
+CycleVrModelIndex(int &index, int count, int direction)
+{
+	if(count > 0 && direction != 0)
+		index = (index+count+(direction > 0 ? 1 : -1))%count;
+}
+
+bool
+CycleVrCheatSelection(int index, int direction)
+{
+	if(direction == 0) return false;
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		const int current = FindVrCycleCarModel(gVrCycleCarCursor);
+		if(current < 0) return false;
+		gVrCycleCarCursor = FindVrCycleCarModelDirection(
+			current+(direction > 0 ? 1 : -1), direction);
+		return gVrCycleCarCursor >= 0;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_MOTORCYCLE)
+		CycleVrModelIndex(gVrCycleBikeIndex,
+			ARRAY_SIZE(gVrCycleBikeModels), direction);
+	else if(index == VR_SPECIAL_SPAWN_NEXT_HELICOPTER)
+		CycleVrModelIndex(gVrCycleHelicopterIndex,
+			ARRAY_SIZE(gVrCycleHelicopterModels), direction);
+	else if(index == VR_SPECIAL_SPAWN_NEXT_AIRPLANE)
+		CycleVrModelIndex(gVrCycleAirplaneIndex,
+			ARRAY_SIZE(gVrCycleAirplaneModels), direction);
+	else
+		return false;
+	return true;
+}
