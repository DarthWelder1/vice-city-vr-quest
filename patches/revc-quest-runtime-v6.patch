+	// Resolve and materialise every handle before exposing the cache to the
+	// collision loop.  This is the complete pre-side-effect validation pass.
+	for(int32 itemIndex = 0; itemIndex < cache.numItems; itemIndex++){
+		CEntity *entity = VrResolveCollisionFlatItem(cache.items[itemIndex]);
+		if(entity == nil || entity->GetType() != cache.items[itemIndex].type)
+			goto stale;
+		cache.nodes[itemIndex].item = entity;
+	}
+	for(int32 sectorIndex = 0; sectorIndex < cache.numSectors; sectorIndex++){
+		for(int32 listIndex = 0; listIndex < VR_COLLISION_FLAT_NUM_LISTS; listIndex++){
+			const SVrCollisionFlatRange &range = cache.sectors[sectorIndex].lists[listIndex];
+			CPtrList &view = cache.listViews[sectorIndex][listIndex];
+			view.first = range.count ? &cache.nodes[range.first] : nil;
+			for(int32 offset = 0; offset < range.count; offset++){
+				const int32 itemIndex = range.first + offset;
+				CPtrNode &node = cache.nodes[itemIndex];
+				node.prev = offset ? &cache.nodes[itemIndex - 1] : nil;
+				node.next = offset + 1 < range.count ? &cache.nodes[itemIndex + 1] : nil;
+			}
+		}
+	}
+
+	cache.topologyRevision = gVrCollisionTopologyRevision;
+	cache.built = true;
+	CPhysical::NumVrCollisionFlatBuilds++;
+	CPhysical::NumVrCollisionFlatItems += cache.numItems;
+	return true;
+
+overflow:
+	CPhysical::NumVrCollisionFlatOverflows++;
+	cache.disabled = true;
+	cache.built = false;
+	cache.ClearViews();
+	return false;
+
+stale:
+	CPhysical::NumVrCollisionFlatStale++;
+	cache.disabled = true;
+	cache.built = false;
+	cache.ClearViews();
+	return false;
+}
+
+// Complete validation happens before AdvanceCurrentScanCode and before the
+// first live collision test.  A failure therefore falls back to the untouched
+// original linked-list path without duplicating any side effect.
+static bool
+VrPrepareCollisionFlatCache(CPhysical *owner)
+{
+	SVrCollisionFlatCache &cache = gVrCollisionFlatCache;
+	if(cache.scopeDepth <= 0 || cache.owner != owner || cache.disabled)
+		return false;
+	if(!cache.built && !VrBuildCollisionFlatCache(owner))
+		return false;
+	if(cache.topologyRevision != gVrCollisionTopologyRevision){
+		CPhysical::NumVrCollisionFlatStale++;
+		cache.disabled = true;
+		cache.ClearViews();
+		return false;
+	}
+
+	if(cache.usedOnce){
+		CPhysical::NumVrCollisionFlatReuses++;
+		CPhysical::NumVrCollisionFlatSavedNodeVisits += cache.numItems;
+	}else
+		cache.usedOnce = true;
+	return true;
+}
+
+class CVrCollisionFlatScopeGuard
+{
+	CPhysical *m_owner;
+public:
+	CVrCollisionFlatScopeGuard(CPhysical *owner, bool activate)
+	 : m_owner(nil)
+	{
+		if(activate && owner->BeginVrCollisionFlatCacheScope())
+			m_owner = owner;
+	}
+	~CVrCollisionFlatScopeGuard(void)
+	{
+		if(m_owner)
+			m_owner->EndVrCollisionFlatCacheScope();
+	}
+	void Activate(CPhysical *owner)
+	{
+		if(m_owner == nil && owner->BeginVrCollisionFlatCacheScope())
+			m_owner = owner;
+	}
+};
