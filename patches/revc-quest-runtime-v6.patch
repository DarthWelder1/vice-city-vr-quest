+bool
+CEntity::IsEntityOccluded(const COcclusionContext &context)
+{
+	if(context.numActiveOccluders == 0)
+		return false;
+
+	CColModel *colModel =
+		CModelInfo::GetModelInfo(GetModelIndex())->GetColModel();
+	if(colModel == nil)
+		return false;
+
+	const CVector &boundMin = colModel->boundingBox.min;
+	const CVector &boundMax = colModel->boundingBox.max;
+	CVector projectedCorners[8];
+	float nearestDepth = 0.0f;
+	for(int corner = 0; corner < 8; corner++){
+		const CVector localCorner(
+			(corner & 1) ? boundMax.x : boundMin.x,
+			(corner & 2) ? boundMax.y : boundMin.y,
+			(corner & 4) ? boundMax.z : boundMin.z);
+		const CVector worldCorner = m_matrix * localCorner;
+		if(!CalcScreenCoors(context, worldCorner, &projectedCorners[corner]))
+			return false;
+		if(corner == 0 || projectedCorners[corner].z < nearestDepth)
+			nearestDepth = projectedCorners[corner].z;
+	}
+
+	for(int i = 0; i < context.numActiveOccluders; i++){
+		const CActiveOccluder &occluder = context.activeOccluders[i];
+		if(nearestDepth <= occluder.farDepth)
+			continue;
+		bool fullyInside = true;
+		for(int corner = 0; corner < 8; corner++){
+			if(!occluder.IsPointWithinOcclusionArea(
+			     projectedCorners[corner].x, projectedCorners[corner].y, 0.0f)){
+				fullyInside = false;
+				break;
+			}
+		}
+		if(fullyInside)
+			return true;
+	}
+	return false;
+}
+
+static bool
+CalcScreenCoors(const COcclusionContext &context, CVector const &in,
+	CVector *out, float *outw, float *outh)
+{
+	*out = context.viewMatrix * in;
+	if(out->z <= 1.0f)
+		return false;
+	const float recip = 1.0f / out->z;
+	out->x *= context.screenWidth * recip;
+	out->y *= context.screenHeight * recip;
+	const float fovScale = DefaultFOV / context.fov;
+	*outw = fovScale * recip * context.screenWidth;
+	*outh = fovScale * recip * context.screenHeight;
+	return true;
+}
+
+static bool
+CalcScreenCoors(const COcclusionContext &context, CVector const &in,
+	CVector *out)
+{
+	float width, height;
+	return CalcScreenCoors(context, in, out, &width, &height);
+}
+
+bool
+COcclusion::IsPositionOccluded(const COcclusionContext &context,
+	CVector pos, float side)
+{
+	CVector coors;
+	float width, height;
+	if(context.numActiveOccluders == 0 ||
+	   !CalcScreenCoors(context, pos, &coors, &width, &height))
+		return false;
+
+	const float area = Max(width, height) * side;
+	for(int i = 0; i < context.numActiveOccluders; i++){
+		const CActiveOccluder &occluder = context.activeOccluders[i];
+		if(coors.z - side*0.85f > occluder.radius &&
+		   occluder.IsPointWithinOcclusionArea(coors.x, coors.y, area))
+			return true;
+	}
+	return false;
+}
+
+#ifdef RW_VULKAN
+static bool
+SegmentEntersOccluderBeforeTarget(const COccluder &occluder,
+	const CVector &eye, const CVector &target, float edgeInset,
+	float targetSeparation)
+{
+	const float angle = occluder.angle*TWOPI/UINT16_MAX;
+	const float s = Sin(angle);
+	const float c = Cos(angle);
+	const CVector axisLength(s, -c, 0.0f);
+	const CVector axisWidth(c, s, 0.0f);
+	const CVector centre((float)occluder.x, (float)occluder.y,
+		(float)occluder.z);
+	const CVector eyeDelta = eye-centre;
+	const CVector targetDelta = target-centre;
+	const float start[3] = {
+		DotProduct(eyeDelta, axisLength),
+		DotProduct(eyeDelta, axisWidth), eyeDelta.z
+	};
+	const float finish[3] = {
+		DotProduct(targetDelta, axisLength),
+		DotProduct(targetDelta, axisWidth), targetDelta.z
+	};
+	const float extent[3] = {
+		Max(0.0f, Abs((float)occluder.length)*0.5f-edgeInset),
+		Max(0.0f, Abs((float)occluder.width)*0.5f-edgeInset),
+		Max(0.0f, Abs((float)occluder.height)*0.5f-edgeInset)
+	};
+	if(extent[0] <= 0.0f || extent[1] <= 0.0f || extent[2] <= 0.0f)
+		return false;
+
+	// If the eye itself lies in an authored volume, fail open.  Treating the
+	// volume surrounding the camera as a wall would erase most of the scene.
+	if(Abs(start[0]) <= extent[0] && Abs(start[1]) <= extent[1] &&
+	   Abs(start[2]) <= extent[2])
+		return false;
+
+	float enter = 0.0f;
+	float leave = 1.0f;
+	for(int axis = 0; axis < 3; axis++){
+		const float delta = finish[axis]-start[axis];
+		if(Abs(delta) < 0.000001f){
+			if(start[axis] < -extent[axis] || start[axis] > extent[axis])
+				return false;
+			continue;
+		}
+		float nearT = (-extent[axis]-start[axis])/delta;
+		float farT = (extent[axis]-start[axis])/delta;
+		if(nearT > farT){
+			const float swap = nearT;
+			nearT = farT;
+			farT = swap;
+		}
+		enter = Max(enter, nearT);
+		leave = Min(leave, farT);
+		if(enter > leave)
+			return false;
+	}
+
+	const float segmentLength = (target-eye).Magnitude();
+	return enter >= 0.0f && enter <= 1.0f &&
+	       enter*segmentLength+targetSeparation < segmentLength;
+}
+
+bool
+COcclusion::IsEntityOccludedByVolumeStereo(CEntity *entity,
+	const CVector eyePosition[2], bool aggressive)
+{
+	if(entity == nil || eyePosition == nil || NumOccludersOnMap <= 0)
+		return false;
+	CBaseModelInfo *modelInfo = CModelInfo::GetModelInfo(entity->GetModelIndex());
+	CColModel *colModel = modelInfo != nil ? modelInfo->GetColModel() : nil;
+	if(colModel == nil)
+		return false;
+
+	const CVector &sourceMin = colModel->boundingBox.min;
+	const CVector &sourceMax = colModel->boundingBox.max;
+	const CVector localCentre = (sourceMin+sourceMax)*0.5f;
+	const float coreScale = aggressive ? 0.35f : 1.0f;
+	const CVector halfSize = (sourceMax-sourceMin)*(0.5f*coreScale);
+	CVector worldCorners[8];
+	for(int corner = 0; corner < 8; corner++){
+		const CVector local = localCentre+CVector(
+			(corner & 1) ? halfSize.x : -halfSize.x,
+			(corner & 2) ? halfSize.y : -halfSize.y,
+			(corner & 4) ? halfSize.z : -halfSize.z);
+		worldCorners[corner] = entity->GetMatrix()*local;
+	}
+
+	const CVector targetCentre = entity->GetBoundCentre();
+	const CVector headCentre = (eyePosition[0]+eyePosition[1])*0.5f;
+	const float edgeInset = aggressive ? 0.05f : 0.20f;
+	const float targetSeparation = aggressive ? 0.10f : 0.30f;
+	for(int32 index = 0; index < NumOccludersOnMap; index++){
+		const COccluder &occluder = aOccluders[index];
+		const CVector occluderCentre((float)occluder.x,
+			(float)occluder.y, (float)occluder.z);
+		const float broadRadius = Max(Abs((float)occluder.width),
+			Max(Abs((float)occluder.length), Abs((float)occluder.height)))*0.5f;
+		if((occluderCentre-headCentre).Magnitude()-broadRadius > 250.0f)
+			continue;
+		// A centre-ray miss proves that this convex box cannot contain every
+		// target-corner ray, and avoids the 16-ray detailed test in almost all
+		// cases.
+		if(!SegmentEntersOccluderBeforeTarget(occluder, eyePosition[0],
+		     targetCentre, edgeInset, targetSeparation) ||
+		   !SegmentEntersOccluderBeforeTarget(occluder, eyePosition[1],
+		     targetCentre, edgeInset, targetSeparation))
+			continue;
+
+		bool fullyHidden = true;
+		for(int eye = 0; eye < 2 && fullyHidden; eye++)
+			for(int corner = 0; corner < 8; corner++)
+				if(!SegmentEntersOccluderBeforeTarget(occluder,
+				     eyePosition[eye], worldCorners[corner], edgeInset,
+				     targetSeparation)){
+					fullyHidden = false;
+					break;
+				}
+		if(fullyHidden)
+			return true;
+	}
+	return false;
+}
+#endif
