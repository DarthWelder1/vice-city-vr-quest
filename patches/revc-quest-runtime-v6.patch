+static bool
+OpenVrStoryBridges(void)
+{
+	if(CPools::GetObjectPool() == nil || ThePaths.m_numCarPathNodes <= 0)
+		return false;
+	int changed = 0;
+	for(int i = CPools::GetObjectPool()->GetSize()-1; i >= 0; i--){
+		CObject *object = CPools::GetObjectPool()->GetSlot(i);
+		if(!object || object->ObjectCreatedBy != MISSION_OBJECT ||
+		   object->bIsPickup) continue;
+		const CVector position = object->GetPosition();
+		bool onClosedPath = false;
+		for(int n = 0; n < ThePaths.m_numCarPathNodes; n++){
+			if(!ThePaths.m_pathNodes[n].bDisabled ||
+			   ThePaths.WasDisabledByMap(n)) continue;
+			const CVector node = ThePaths.m_pathNodes[n].GetPosition();
+			if(Abs(node.z-position.z) < 5.0f &&
+			   (CVector2D(node.x,node.y)-CVector2D(position.x,position.y)).
+				MagnitudeSqr() < 144.0f){ onClosedPath = true; break; }
+		}
+		if(!onClosedPath) continue;
+		CWorld::Remove(object);
+		object->SetPosition(CVector(position.x, position.y, position.z-500.0f));
+		object->GetMatrix().UpdateRW(); object->UpdateRwFrame();
+		CWorld::Add(object); changed++;
+	}
+	for(int n = 0; n < ThePaths.m_numCarPathNodes; n++)
+		if(ThePaths.m_pathNodes[n].bDisabled &&
+		   !ThePaths.WasDisabledByMap(n)){
+			ThePaths.m_pathNodes[n].bDisabled = false; changed++;
+		}
+	return changed != 0;
 }
 
