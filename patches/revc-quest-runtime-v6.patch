+// This cache never performs collision work.  It only records the exact sector,
+// list and node membership order so repeated CheckCollision calls avoid walking
+// the world's linked lists.  All live tests and all collision side effects stay
+// in ProcessCollisionSectorList on the main thread.
+enum {
+	VR_COLLISION_FLAT_MAX_SECTORS = 64,
+	VR_COLLISION_FLAT_MAX_ITEMS = 4096,
+	VR_COLLISION_FLAT_NUM_LISTS = ENTITYLIST_PEDS_OVERLAP + 1
+};
+
+struct SVrCollisionFlatItem
+{
+	int32 handle;
+	uint8 type;
+	uint8 pool;
+};
+
+enum eVrCollisionFlatPool {
+	VR_COLLISION_POOL_BUILDING,
+	VR_COLLISION_POOL_TREADABLE,
+	VR_COLLISION_POOL_VEHICLE,
+	VR_COLLISION_POOL_PED,
+	VR_COLLISION_POOL_OBJECT
+};
+
+struct SVrCollisionFlatRange
+{
+	uint16 first;
+	uint16 count;
+};
+
+struct SVrCollisionFlatSector
+{
+	SVrCollisionFlatRange lists[VR_COLLISION_FLAT_NUM_LISTS];
+};
+
+struct SVrCollisionFlatCache
+{
+	CPhysical *owner;
+	uint32 topologyRevision;
+	int32 scopeDepth;
+	int32 numSectors;
+	int32 numItems;
+	bool built;
+	bool disabled;
+	bool usedOnce;
+	SVrCollisionFlatSector sectors[VR_COLLISION_FLAT_MAX_SECTORS];
+	SVrCollisionFlatItem items[VR_COLLISION_FLAT_MAX_ITEMS];
+	CPtrNode nodes[VR_COLLISION_FLAT_MAX_ITEMS];
+	CPtrList listViews[VR_COLLISION_FLAT_MAX_SECTORS][VR_COLLISION_FLAT_NUM_LISTS];
+
+	SVrCollisionFlatCache(void)
+	 : owner(nil), topologyRevision(0), scopeDepth(0), numSectors(0),
+	   numItems(0), built(false), disabled(false), usedOnce(false)
+	{
+	}
+
+	~SVrCollisionFlatCache(void)
+	{
+		ClearViews();
+	}
+
+	void ClearViews(void)
+	{
+		for(int32 sector = 0; sector < VR_COLLISION_FLAT_MAX_SECTORS; sector++)
+			for(int32 list = 0; list < VR_COLLISION_FLAT_NUM_LISTS; list++)
+				listViews[sector][list].first = nil;
+	}
+
+	void Reset(CPhysical *newOwner)
+	{
+		ClearViews();
+		owner = newOwner;
+		topologyRevision = 0;
+		numSectors = 0;
+		numItems = 0;
+		built = false;
+		disabled = false;
+		usedOnce = false;
+	}
+};
+
+static SVrCollisionFlatCache gVrCollisionFlatCache;
+static uint32 gVrCollisionTopologyRevision = 1;
+
+static CEntity *
+VrResolveCollisionFlatItem(const SVrCollisionFlatItem &item)
+{
+	switch(item.pool){
+	case VR_COLLISION_POOL_BUILDING:
+		return CPools::GetBuildingPool()->GetAt(item.handle);
+	case VR_COLLISION_POOL_TREADABLE:
+		return CPools::GetTreadablePool()->GetAt(item.handle);
+	case VR_COLLISION_POOL_VEHICLE:
+		return CPools::GetVehicle(item.handle);
+	case VR_COLLISION_POOL_PED:
+		return CPools::GetPed(item.handle);
+	case VR_COLLISION_POOL_OBJECT:
+		return CPools::GetObject(item.handle);
+	default:
+		return nil;
+	}
+}
+
+static bool
+VrCaptureCollisionFlatItem(CEntity *entity, SVrCollisionFlatItem &item)
+{
+	item.type = entity->GetType();
+	switch(item.type){
+	case ENTITY_TYPE_BUILDING: {
+		CBuilding *building = (CBuilding*)entity;
+		if(building->GetIsATreadable()){
+			item.pool = VR_COLLISION_POOL_TREADABLE;
+			item.handle = CPools::GetTreadablePool()->GetIndex((CTreadable*)building);
+		}else{
+			item.pool = VR_COLLISION_POOL_BUILDING;
+			item.handle = CPools::GetBuildingPool()->GetIndex(building);
+		}
+		break;
+	}
+	case ENTITY_TYPE_VEHICLE:
+		item.pool = VR_COLLISION_POOL_VEHICLE;
+		item.handle = CPools::GetVehicleRef((CVehicle*)entity);
+		break;
+	case ENTITY_TYPE_PED:
+		item.pool = VR_COLLISION_POOL_PED;
+		item.handle = CPools::GetPedRef((CPed*)entity);
+		break;
+	case ENTITY_TYPE_OBJECT:
+		item.pool = VR_COLLISION_POOL_OBJECT;
+		item.handle = CPools::GetObjectRef((CObject*)entity);
+		break;
+	default:
+		return false;
+	}
+	return item.handle >= 0 && VrResolveCollisionFlatItem(item) == entity;
