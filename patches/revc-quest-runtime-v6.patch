+
+static bool
+VrBuildCollisionFlatCache(CPhysical *owner)
+{
+	SVrCollisionFlatCache &cache = gVrCollisionFlatCache;
+	cache.ClearViews();
+	cache.numSectors = 0;
+	cache.numItems = 0;
+
+	for(CEntryInfoNode *entry = owner->m_entryInfoList.first; entry; entry = entry->next){
+		if(cache.numSectors >= VR_COLLISION_FLAT_MAX_SECTORS)
+			goto overflow;
+
+		SVrCollisionFlatSector &flatSector = cache.sectors[cache.numSectors];
+		for(int32 listIndex = 0; listIndex < VR_COLLISION_FLAT_NUM_LISTS; listIndex++){
+			SVrCollisionFlatRange &range = flatSector.lists[listIndex];
+			range.first = (uint16)cache.numItems;
+			range.count = 0;
+			for(CPtrNode *node = entry->sector->m_lists[listIndex].first; node; node = node->next){
+				if(cache.numItems >= VR_COLLISION_FLAT_MAX_ITEMS)
+					goto overflow;
+				if(!VrCaptureCollisionFlatItem((CEntity*)node->item, cache.items[cache.numItems]))
+					goto stale;
+				cache.numItems++;
+				range.count++;
+			}
+		}
+		cache.numSectors++;
+	}
