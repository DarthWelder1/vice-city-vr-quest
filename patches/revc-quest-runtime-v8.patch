+// The watch. False when the panel is off, so the corner clock prints as usual.
+static bool
+DrawWristClockQuad(void)
+{
+	if (!androidgame::VrWristPanelEnabled(VR_WRIST_PANEL_CLOCK))
+		return false;
+	if (FindPlayerVehicle() != nil && !VrWristPanelsRideAlong())
+		return false;
+
+	const float width = SCREEN_SCALE_X(VR_WRIST_CLOCK_WIDTH);
+	const float height = SCREEN_SCALE_Y(VR_WRIST_CLOCK_HEIGHT);
+	RwRaster *panel = (RwRaster*)androidgame::BeginVrWristPanel(
+		VR_WRIST_PANEL_CLOCK, width*0.5f, height*0.5f, width, height);
+	if (panel == nil)
+		return true;
+
+	CRect rect(0.0f, 0.0f, width, height);
+	const CRGBA white(255, 255, 255, 255);
+	CSprite2d::SetVertices(rect, white, white, white, white);
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, panel);
+	RwRenderStateSet(rwRENDERSTATETEXTUREFILTER, (void*)rwFILTERLINEAR);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	GameRender::SubmitImmediate2D(rwPRIMTYPETRIFAN, CSprite2d::GetVertices(), 4);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	androidgame::EndVrWristPanel();
+	return true;
+}
 #endif
 
 
