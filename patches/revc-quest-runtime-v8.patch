+// The watch. False when the panel is off, so the corner clock prints as usual.
+static void
+DrawWristAmmoOnHand(int hand, float width, float height)
+{
+	RwRaster *panel = (RwRaster*)androidgame::BeginVrWristPanel(
+		VR_WRIST_PANEL_AMMO, width*0.5f, height*0.5f, width, height,
+		hand);
+	if (panel == nil)
+		return;
+
+	CRect rect(0.0f, 0.0f, width, height);
+	const CRGBA white(255, 255, 255, 255);
+	CSprite2d::SetVertices(rect, white, white, white, white);
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, panel);
+	RwRenderStateSet(rwRENDERSTATETEXTUREFILTER, (void*)rwFILTERLINEAR);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	GameRender::SubmitImmediate2D(rwPRIMTYPETRIFAN, CSprite2d::GetVertices(), 4);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	androidgame::EndVrWristPanel();
+}
+
+static bool
+DrawWristAmmoQuad(void)
+{
+	if (!androidgame::VrWristPanelEnabled(VR_WRIST_PANEL_AMMO))
+		return false;
+	if (FindPlayerVehicle() != nil && !VrWristPanelsRideAlong())
+		return false;
+	CPlayerPed *player = FindPlayerPed();
+	// Nothing to count for a bare fist, and nothing to hang the panel on.
+	if (player == nil || player->GetWeapon() == nil ||
+	    player->GetWeapon()->m_eWeaponType == WEAPONTYPE_UNARMED)
+		return false;
+	// A bat has one of itself. Counting that is noise, not information.
+	CWeaponInfo *info = CWeaponInfo::GetWeaponInfo(
+		(eWeaponType)player->GetWeapon()->m_eWeaponType);
+	if (info == nil || info->m_eWeaponFire == WEAPON_FIRE_MELEE)
+		return false;
+
+	const float width = SCREEN_SCALE_X(VR_WRIST_AMMO_WIDTH);
+	const float height = SCREEN_SCALE_Y(VR_WRIST_AMMO_HEIGHT);
+	// The counter belongs to the hand that is holding the gun, whichever
+	// that is, and to both of them when both are armed. Only when no hand
+	// has physically taken a weapon does the configured arm carry it.
+	bool drawn = false;
+	for (int hand = 0; hand < 2; hand++)
+		if (OculusVR::GetHeldWeaponSlot(hand) >= 0) {
+			DrawWristAmmoOnHand(hand, width, height);
+			drawn = true;
+		}
+	if (!drawn)
+		DrawWristAmmoOnHand(
+			androidgame::VrWristPanelHand(VR_WRIST_PANEL_AMMO) ? 1 : 0,
+			width, height);
+	return true;
+}
+
