+// The hours and minutes, drawn into the clock panel's own target with the
+// same font work the corner clock uses. Centred in the panel rect rather than
+// right-justified against a screen edge that does not exist here.
+void
+VrDrawWristClockContents(void)
+{
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	CFont::SetJustifyOff();
+	CFont::SetBackgroundOff();
+	CFont::SetScale(SCREEN_SCALE_X(HUD_TEXT_SCALE_X), SCREEN_SCALE_Y(HUD_TEXT_SCALE_Y));
+	CFont::SetBackGroundOnlyTextOff();
+	CFont::SetPropOff();
+	CFont::SetFontStyle(FONT_HEADING);
+	CFont::SetRightJustifyOff();
+	CFont::SetCentreOn();
+	CFont::SetCentreSize(SCREEN_SCALE_X(VR_WRIST_CLOCK_WIDTH));
+	CFont::SetDropShadowPosition(2);
+	CFont::SetDropColor(CRGBA(0, 0, 0, 255));
+	CFont::SetColor(CLOCK_COLOR);
+	char text[16];
+	wchar wide[16];
+	sprintf(text, "%02d:%02d", CClock::GetHours(), CClock::GetMinutes());
+	AsciiToUnicode(text, wide);
+	CFont::PrintString(SCREEN_SCALE_X(VR_WRIST_CLOCK_WIDTH)*0.5f,
+		SCREEN_SCALE_Y(VR_WRIST_CLOCK_MARGIN), wide);
+	CFont::DrawFonts();
+	CFont::SetCentreOff();
+}
+
+// The round count, drawn where the shooter is already looking: along the
+// weapon. The hand it is worn on is the one holding the gun, and the
+// visual hand matrix follows the grip, so the panel travels with it.
+void
+VrDrawWristAmmoContents(void)
+{
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil)
+		return;
+	CWeapon *weapon = player->GetWeapon();
+	if (weapon == nil)
+		return;
+	const int32 type = weapon->m_eWeaponType;
+	const int32 amount =
+		CWeaponInfo::GetWeaponInfo((eWeaponType)type)->m_nAmountofAmmunition;
+	char text[24];
+	// The same reserve-clip split the corner readout uses, so a player who
+	// knows the flat interface reads this one without being told.
+	if (amount <= 1 || amount >= 1000)
+		sprintf(text, "%d", weapon->m_nAmmoTotal);
+	else {
+		const int32 divisor = type == WEAPONTYPE_FLAMETHROWER ? 10 : 1;
+		const int32 clip = weapon->m_nAmmoInClip/divisor;
+		const int32 reserve = Min((weapon->m_nAmmoTotal-
+			weapon->m_nAmmoInClip)/divisor, 9999);
+		sprintf(text, "%d-%d", reserve, clip);
+	}
+	uint8 red = 90, green = 235, blue = 120;
+	androidgame::VrWristAmmoColour(&red, &green, &blue);
+	CFont::SetJustifyOff();
+	CFont::SetBackgroundOff();
+	CFont::SetScale(SCREEN_SCALE_X(HUD_TEXT_SCALE_X), SCREEN_SCALE_Y(HUD_TEXT_SCALE_Y));
+	CFont::SetBackGroundOnlyTextOff();
+	CFont::SetPropOff();
+	// The blocky face the game counts with, not the serif one it writes
+	// dialogue in: these are digits read at a glance in a firefight.
+	CFont::SetFontStyle(FONT_HEADING);
+	CFont::SetRightJustifyOff();
+	CFont::SetCentreOn();
+	CFont::SetCentreSize(SCREEN_SCALE_X(VR_WRIST_AMMO_WIDTH));
+	CFont::SetDropShadowPosition(2);
+	CFont::SetDropColor(CRGBA(0, 0, 0, 255));
+	CFont::SetColor(CRGBA(red, green, blue, 255));
+	wchar wide[24];
+	AsciiToUnicode(text, wide);
+	CFont::PrintString(SCREEN_SCALE_X(VR_WRIST_AMMO_WIDTH)*0.5f,
+		SCREEN_SCALE_Y(VR_WRIST_AMMO_MARGIN), wide);
+	CFont::DrawFonts();
+	CFont::SetCentreOff();
+}
