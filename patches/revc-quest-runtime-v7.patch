+#if defined(RW_VULKAN) && defined(__ANDROID__)
+// Called by the Vulkan backend with the wrist minimap's target open and the
+// interface transform mapping these screen coordinates straight onto it. The
+// frame has not drawn anything yet at this point, so the 2D states the map
+// expects are set here rather than inherited.
+void
+VrDrawWristRadarContents(void)
+{
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+	DrawRadarContents();
+}
+
+// The finished map on the player's arm: one textured quad, depth tested like
+// anything else out there. False when the panel is off, so the flat interface
+// draws the radar as it always did.
+static bool
+DrawWristRadarQuad(void)
+{
+	if (!androidgame::VrWristPanelEnabled(VR_WRIST_PANEL_MAP))
+		return false;
+	// A vehicle either hides the arms or puts them somewhere a panel cannot be
+	// read, so the classic interface comes back for the drive.
+	if (FindPlayerVehicle() != nil)
+		return false;
+
+	const float width = SCREEN_SCALE_X(RADAR_WIDTH)+SCREEN_SCALE_X(12.0f);
+	const float height = SCREEN_SCALE_Y(RADAR_HEIGHT)+SCREEN_SCALE_Y(12.0f);
+	const float centreX = SCREEN_SCALE_X_FIX(RADAR_LEFT)+
+		SCREEN_SCALE_X(RADAR_WIDTH)*0.5f;
+	const float centreY = SCREEN_SCALE_FROM_BOTTOM(RADAR_BOTTOM+RADAR_HEIGHT)+
+		SCREEN_SCALE_Y(RADAR_HEIGHT)*0.5f;
+	// This is also what asks for the next frame's render, so it runs even on
+	// the frames where there is nothing to show yet.
+	RwRaster *map = (RwRaster*)androidgame::BeginVrWristPanel(
+		VR_WRIST_PANEL_MAP, centreX, centreY, width, height);
+	if (map == nil)
+		return true;
+
+	CRect rect(centreX-width*0.5f, centreY-height*0.5f,
+		centreX+width*0.5f, centreY+height*0.5f);
+	const CRGBA white(255, 255, 255, 255);
+	CSprite2d::SetVertices(rect, white, white, white, white);
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, map);
+	RwRenderStateSet(rwRENDERSTATETEXTUREFILTER, (void*)rwFILTERLINEAR);
+	// Blended so the map keeps its round shape, and depth tested because it is
+	// a thing on the arm now. No depth write: the transparent corners have no
+	// business masking anything.
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	GameRender::SubmitImmediate2D(rwPRIMTYPETRIFAN, CSprite2d::GetVertices(), 4);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	androidgame::EndVrWristPanel();
+	return true;
+}
+
+// Called by the Vulkan backend with the status panel's target open and the
+// interface transform mapping these screen coordinates straight onto it.
+void
+VrDrawWristStatusContents(void)
+{
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	DrawStatusContents();
+	// Text is batched and would otherwise be flushed long after this pass has
+	// closed -- straight onto the interface plane instead of into the panel.
+	CFont::DrawFonts();
+}
+
+// The finished readout on the player's other arm. False when the panel is
+// off, so the flat interface draws it as it always did.
+static bool
+DrawWristStatusQuad(void)
+{
+	if (!androidgame::VrWristPanelEnabled(VR_WRIST_PANEL_STATUS) ||
+		FindPlayerVehicle() != nil)
+		return false;
+
+	// The block the money, health, armour and wanted rows occupy, with a
+	// little air around it.
+	const float left = SCREEN_SCALE_FROM_RIGHT(292.0f);
+	const float right = SCREEN_SCALE_FROM_RIGHT(96.0f);
+	const float top = SCREEN_SCALE_Y(30.0f);
+	const float bottom = SCREEN_SCALE_Y(106.0f);
+	const float width = right-left;
+	const float height = bottom-top;
+	// This is also what asks for the next frame's render, so it runs even on
+	// the frames where there is nothing to show yet.
+	RwRaster *panel = (RwRaster*)androidgame::BeginVrWristPanel(
+		VR_WRIST_PANEL_STATUS, (left+right)*0.5f, (top+bottom)*0.5f,
+		width, height);
+	if (panel == nil)
+		return true;
+
+	CRect rect(left, top, right, bottom);
+	const CRGBA white(255, 255, 255, 255);
+	CSprite2d::SetVertices(rect, white, white, white, white);
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, panel);
+	RwRenderStateSet(rwRENDERSTATETEXTUREFILTER, (void*)rwFILTERLINEAR);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	GameRender::SubmitImmediate2D(rwPRIMTYPETRIFAN, CSprite2d::GetVertices(), 4);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	androidgame::EndVrWristPanel();
+	return true;
+}
