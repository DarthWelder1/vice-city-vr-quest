+// The map, its disc and the blips, in screen coordinates. Kept apart from
+// CHud::Draw because the wrist minimap runs exactly this code into a texture
+// of its own, before the frame's render pass opens.
+static void
+DrawRadarContents(void)
+{
+	RwRenderStateSet(rwRENDERSTATETEXTUREFILTER, (void*)rwFILTERNEAREST);
+	CRadar::DrawMap();
+	// DrawRadarMap intentionally leaves its strict depth state active
+	// for the circular mask. The disc and blips are HUD geometry and
+	// must remain visible over a vehicle cockpit.
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	if (FrontEndMenuManager.m_PrefsRadarMode != 1) {
+		CRect rect(0.0f, 0.0f, SCREEN_SCALE_X(RADAR_WIDTH), SCREEN_SCALE_Y(RADAR_HEIGHT));
+
+		rect.Translate(SCREEN_SCALE_X_FIX(RADAR_LEFT), SCREEN_SCALE_FROM_BOTTOM(RADAR_BOTTOM + RADAR_HEIGHT));
+
+#ifdef FIX_BUGS
+		rect.Grow(SCREEN_SCALE_X(6.0f), SCREEN_SCALE_X(6.0f), SCREEN_SCALE_Y(6.0f), SCREEN_SCALE_Y(6.0f));
+#else
+		rect.Grow(6.0f);
+#endif
+		rect.Translate(SCREEN_SCALE_X_FIX(0.0f), SCREEN_SCALE_Y_FIX(2.0f));
+		CHud::Sprites[HUD_RADARDISC].Draw(rect, CRGBA(0, 0, 0, 255));
+		rect.Translate(SCREEN_SCALE_X_FIX(0.0f), SCREEN_SCALE_Y_FIX(-2.0f));
+		CHud::Sprites[HUD_RADARDISC].Draw(rect, RADARDISC_COLOR);
+	}
+	CRadar::DrawBlips();
+}
