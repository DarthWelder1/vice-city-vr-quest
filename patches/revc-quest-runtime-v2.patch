+static bool
+IsRunWithoutLimitsCheatEnabled(void)
+{
+#if defined(GTA_VR_OCULUS) || defined(GTA_VR_WEAPONS)
+	return OculusVR::IsRunWithoutLimitsEnabled();
+#else
+	return false;
+#endif
+}
+
+static bool
+IsHeavyWeaponMobilityRestricted(CPlayerPed *player)
+{
+	if(IsRunWithoutLimitsCheatEnabled())
+		return false;
+#if defined(GTA_VR_OCULUS) || defined(GTA_VR_WEAPONS)
+	// In physical-VR mode the inventory's selected slot is not necessarily in
+	// either hand. Rampages select their supplied weapon immediately, which used
+	// to disable sprinting even while that weapon was still in its holster.
+	if(OculusVR::IsPhysicalWeaponInteractionActive()){
+		for(int hand = 0; hand < 2; hand++){
+			const int heldSlot = OculusVR::GetHeldWeaponSlot(hand);
+			if(heldSlot >= 0 && heldSlot < TOTAL_WEAPON_SLOTS &&
+			   CWeaponInfo::GetWeaponInfo(
+				player->GetWeapon(heldSlot).m_eWeaponType)->
+				IsFlagSet(WEAPONFLAG_HEAVY))
+				return true;
+		}
+		return false;
+	}
+#endif
+	return CWeaponInfo::GetWeaponInfo(player->GetWeapon()->m_eWeaponType)->
+		IsFlagSet(WEAPONFLAG_HEAVY);
+}
+
+static bool
+ShouldPlayerSprint(CPlayerPed *player, CPad *pad)
+{
+	if(!pad)
+		return false;
+	if(IsRunWithoutLimitsCheatEnabled()){
+		// This cheat is intentionally an always-run mode, not only infinite
+		// stamina. It therefore remains useful in Rampages whose script-selected
+		// heavy weapon is not physically in either hand.
+		return pad->GetPedWalkLeftRight() != 0 ||
+			pad->GetPedWalkUpDown() != 0;
+	}
+	return !IsHeavyWeaponMobilityRestricted(player) && pad->GetSprint();
+}
