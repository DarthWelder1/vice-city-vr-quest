<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- 6DOF headset with tracked controllers. Required, not optional: the
	     game has no flat-screen path on this platform. -->
	<uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
	<uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
	<uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />

	<!-- Hand tracking is deliberately NOT declared. Input is touch controllers
	     only. With hand tracking available, grabbing the headset to don it
	     reads as the system home gesture: the shell logs "Home Button Press in
	     Immersive App", opens the Navigator over the game and backgrounds it,
	     which looked exactly like the app losing its picture on every don. -->

	<!-- The original Vice City data is staged into the app-specific external
	     directory, which needs no runtime permission. Kept explicit so the
	     staging path stays obvious to anyone reading the manifest. -->
	<application
		android:label="@string/app_name"
		android:icon="@mipmap/ic_launcher"
		android:allowBackup="false"
		android:extractNativeLibs="true">

		<!-- com.oculus.supportedDevices is deliberately absent. It gates store
		     submissions, and an unrecognised token there can make Horizon OS
		     refuse to launch a sideloaded build. -->

		<activity
			android:name="android.app.NativeActivity"
			android:label="@string/app_name"
			android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
			android:launchMode="singleTask"
			android:screenOrientation="landscape"
			android:excludeFromRecents="false"
			android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density"
			android:resizeableActivity="false"
			android:exported="true">

			<meta-data android:name="android.app.lib_name" android:value="miamivr" />

			<!-- Activity-level, not application-level: Horizon OS reads this off
			     the ActivityInfo. Without it the shell treats the app as unable
			     to survive losing focus and backgrounds it the moment any system
			     overlay (Navigator, Guardian, interstitial) appears, which on a
			     passthrough Home happens within a second or two of donning. -->
			<meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<!-- Standard OpenXR immersive category plus the Meta store
				     category, so the app appears in the headset library
				     rather than the 2D panel list. -->
				<category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
				<category android:name="com.oculus.intent.category.VR" />
			</intent-filter>
		</activity>
	</application>
</manifest>
